// Adivina el número: el ordenador piensa un número del 1 al 100 y te dice si es mayor o menor.
// Sin consola interactiva, juega solo usando búsqueda binaria.

const DEMO = not Console.interactive
if DEMO { randomSeed(3) }

var secreto = randomInt(1, 100)
var intentos = 0
var bajo = 1
var alto = 100

print("He pensado un número del 1 al 100. ¿Cuál es?")
while true {
    var n = null
    if DEMO {
        n = floor((bajo + alto) / 2)
        print("> ${n}")
    } else {
        var linea = input("> ")
        if linea == null { break }
        n = toNumber(linea.trim())
        if n == null {
            print("Escribe un número, por favor.")
            continue
        }
    }
    intentos += 1
    if n < secreto {
        print("Más alto")
        bajo = n + 1
    } else if n > secreto {
        print("Más bajo")
        alto = n - 1
    } else {
        print("¡Correcto! Era el ${secreto}. Lo has adivinado en ${intentos} intento${intentos == 1 ? "" : "s"}.")
        break
    }
}
