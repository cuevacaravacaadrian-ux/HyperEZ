// Recursos de hyperez-editor.exe: iconos, manifiesto e información de versión.
#include <winver.h>
#include "../../src/core/version.h"

1 ICON "../../assets/icons/hyperez.ico"
2 ICON "../../assets/icons/hz-file.ico"
// Iconos del Explorador (assets/icons/tema): carpetas 100-119, archivos 130-140
100 ICON "../../assets/icons/tema/carpeta.ico"
101 ICON "../../assets/icons/tema/carpeta-abierta.ico"
102 ICON "../../assets/icons/tema/hypersettings.ico"
103 ICON "../../assets/icons/tema/hypersettings-abierta.ico"
104 ICON "../../assets/icons/tema/hypercode.ico"
105 ICON "../../assets/icons/tema/hypercode-abierta.ico"
106 ICON "../../assets/icons/tema/hypertests.ico"
107 ICON "../../assets/icons/tema/hypertests-abierta.ico"
108 ICON "../../assets/icons/tema/hyperlibs.ico"
109 ICON "../../assets/icons/tema/hyperlibs-abierta.ico"
110 ICON "../../assets/icons/tema/hypertools.ico"
111 ICON "../../assets/icons/tema/hypertools-abierta.ico"
112 ICON "../../assets/icons/tema/hyperassets.ico"
113 ICON "../../assets/icons/tema/hyperassets-abierta.ico"
114 ICON "../../assets/icons/tema/hyperdata.ico"
115 ICON "../../assets/icons/tema/hyperdata-abierta.ico"
116 ICON "../../assets/icons/tema/hyperdocs.ico"
117 ICON "../../assets/icons/tema/hyperdocs-abierta.ico"
118 ICON "../../assets/icons/tema/hyperbuild.ico"
119 ICON "../../assets/icons/tema/hyperbuild-abierta.ico"
130 ICON "../../assets/icons/tema/archivo.ico"
131 ICON "../../assets/icons/tema/archivo-hez.ico"
132 ICON "../../assets/icons/tema/archivo-proyecto.ico"
133 ICON "../../assets/icons/tema/archivo-md.ico"
134 ICON "../../assets/icons/tema/archivo-json.ico"
135 ICON "../../assets/icons/tema/archivo-imagen.ico"
136 ICON "../../assets/icons/tema/archivo-datos.ico"
137 ICON "../../assets/icons/tema/archivo-html.ico"
138 ICON "../../assets/icons/tema/archivo-css.ico"
139 ICON "../../assets/icons/tema/archivo-js.ico"
140 ICON "../../assets/icons/tema/archivo-texto.ico"
1 24 "editor.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HYPEREZ_VERSION_MAJOR, HYPEREZ_VERSION_MINOR, HYPEREZ_VERSION_PATCH, 0
PRODUCTVERSION HYPEREZ_VERSION_MAJOR, HYPEREZ_VERSION_MINOR, HYPEREZ_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "HyperEZ"
      VALUE "FileDescription", "HyperEZ Editor"
      VALUE "FileVersion", HYPEREZ_VERSION
      VALUE "InternalName", "hyperez-editor"
      VALUE "LegalCopyright", "Copyright (C) HyperEZ"
      VALUE "OriginalFilename", "hyperez-editor.exe"
      VALUE "ProductName", "HyperEZ"
      VALUE "ProductVersion", HYPEREZ_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
