// Recursos del instalador (generado por CMake a partir de setup.rc.in)
#include <winver.h>
#include "@HZ_SRC@/src/core/version.h"

1 ICON "@HZ_SRC@/assets/icons/setup.ico"
2 ICON "@HZ_SRC@/assets/icons/hyperez.ico"
1 24 "@HZ_SRC@/packaging/windows/setup.manifest"
PAYLOAD RCDATA "@HZ_PAYLOAD@"

VS_VERSION_INFO VERSIONINFO
FILEVERSION HYPEREZ_VERSION_MAJOR, HYPEREZ_VERSION_MINOR, HYPEREZ_VERSION_PATCH, 0
PRODUCTVERSION HYPEREZ_VERSION_MAJOR, HYPEREZ_VERSION_MINOR, HYPEREZ_VERSION_PATCH, 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "0C0A04B0"
    BEGIN
      VALUE "CompanyName", "HyperEZ"
      VALUE "FileDescription", "Instalador de HyperEZ"
      VALUE "FileVersion", HYPEREZ_VERSION
      VALUE "InternalName", "HyperEZ-Setup"
      VALUE "LegalCopyright", "Copyright (C) HyperEZ"
      VALUE "OriginalFilename", "HyperEZ-Setup.exe"
      VALUE "ProductName", "HyperEZ"
      VALUE "ProductVersion", HYPEREZ_VERSION
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x0C0A, 1200
  END
END
