# Incrusta código HyperEZ en hyper.exe: el preludio y las bibliotecas de src/lib.
#   cmake -DOUT=<archivo.cpp> -DPRELUDE=<prelude.hz> -DLIBDIR=<src/lib> -P embed_hz.cmake
# Cada biblioteca src/lib/<ruta>.hz se importa como `import <ruta con puntos>` (p. ej. src/lib/ai.hz -> import ai).

function(hz_literal var file)
  file(READ "${file}" text)
  string(FIND "${text}" ")HZEMBED\"" bad)
  if(NOT bad EQUAL -1)
    message(FATAL_ERROR "${file} contiene la secuencia reservada )HZEMBED\"")
  endif()
  set(${var} "R\"HZEMBED(${text})HZEMBED\"" PARENT_SCOPE)
endfunction()

hz_literal(prelude "${PRELUDE}")
set(code "// Generado por cmake/embed_hz.cmake a partir de src/lang/prelude y src/lib: no editar.\n")
string(APPEND code "#include <map>\n#include <string>\n\nnamespace hz {\n\n")
string(APPEND code "extern const char* kPreludeName;\nextern const char* kPreludeSource;\n")
string(APPEND code "const char* kPreludeName = \"<preludio>\";\n")
string(APPEND code "const char* kPreludeSource = ${prelude};\n\n")
string(APPEND code "const std::map<std::string, const char*>& embeddedLibraries() {\n")
string(APPEND code "    static const std::map<std::string, const char*> libs = {\n")
file(GLOB_RECURSE libs RELATIVE "${LIBDIR}" "${LIBDIR}/*.hz")
list(SORT libs)
foreach(lib ${libs})
  string(REGEX REPLACE "\\.hz$" "" name "${lib}")
  string(REPLACE "/" "." name "${name}")
  hz_literal(body "${LIBDIR}/${lib}")
  string(APPEND code "        {\"${name}\", ${body}},\n")
endforeach()
string(APPEND code "    };\n    return libs;\n}\n\n} // namespace hz\n")

# Solo se reescribe si cambia (evita recompilar)
if(EXISTS "${OUT}")
  file(READ "${OUT}" old)
  if(old STREQUAL code)
    return()
  endif()
endif()
file(WRITE "${OUT}" "${code}")
