{
  "Variable": {
    "prefix": [
      "var"
    ],
    "body": [
      "var ${1:nombre} = ${2:valor}"
    ],
    "description": "Declara una variable"
  },
  "Constante": {
    "prefix": [
      "const"
    ],
    "body": [
      "const ${1:NOMBRE} = ${2:valor}"
    ],
    "description": "Declara una constante"
  },
  "Función": {
    "prefix": [
      "function",
      "funcion",
      "fn"
    ],
    "body": [
      "/// ${3:Qué hace la función}",
      "function ${1:nombre}(${2}) {",
      "\t$0",
      "}"
    ],
    "description": "Declara una función documentada"
  },
  "Función con tipos": {
    "prefix": [
      "functipo",
      "fnt"
    ],
    "body": [
      "function ${1:nombre}(${2:x}: ${3:number}): ${4:number} {",
      "\treturn ${0:x}",
      "}"
    ],
    "description": "Función con parámetros y resultado tipados"
  },
  "Función async": {
    "prefix": [
      "async",
      "asincrona"
    ],
    "body": [
      "async function ${1:nombre}(${2}) {",
      "\tawait wait(${3:1})",
      "\t$0",
      "}"
    ],
    "description": "Función asíncrona (puede usar await)"
  },
  "Lambda": {
    "prefix": [
      "lambda",
      "=>"
    ],
    "body": [
      "(${1:x}) => ${0:x * 2}"
    ],
    "description": "Función anónima"
  },
  "Clase": {
    "prefix": [
      "class",
      "clase"
    ],
    "body": [
      "/// ${2:Descripción de la clase}",
      "class ${1:Nombre} {",
      "\tvar ${3:nombre}: ${4:text}",
      "",
      "\tconstructor(${3:nombre}: ${4:text}) {",
      "\t\tthis.${3:nombre} = ${3:nombre}",
      "\t}",
      "",
      "\tfunction ${5:metodo}() {",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Declara una clase con constructor y un método"
  },
  "Clase hija": {
    "prefix": [
      "extends",
      "hereda"
    ],
    "body": [
      "class ${1:Hija} extends ${2:Padre} {",
      "\tconstructor(${3}) {",
      "\t\tsuper(${3})",
      "\t\t$0",
      "\t}",
      "}"
    ],
    "description": "Clase que hereda de otra"
  },
  "Struct": {
    "prefix": [
      "struct"
    ],
    "body": [
      "struct ${1:Punto} { var ${2:x}: number = 0; var ${3:y}: number = 0 }"
    ],
    "description": "Estructura de datos (se compara por valor)"
  },
  "Enum": {
    "prefix": [
      "enum"
    ],
    "body": [
      "enum ${1:Estado} { ${2:Menu}, ${3:Jugando}, ${4:Pausa} }"
    ],
    "description": "Enumeración"
  },
  "Interfaz": {
    "prefix": [
      "interface",
      "interfaz"
    ],
    "body": [
      "interface ${1:Nombre} {",
      "\tfunction ${2:metodo}(): ${3:void}",
      "}"
    ],
    "description": "Interfaz que deben cumplir las clases"
  },
  "if": {
    "prefix": [
      "if",
      "si"
    ],
    "body": [
      "if ${1:condicion} {",
      "\t$0",
      "}"
    ],
    "description": "Condición"
  },
  "if / else": {
    "prefix": [
      "ifelse",
      "sino"
    ],
    "body": [
      "if ${1:condicion} {",
      "\t$2",
      "} else {",
      "\t$0",
      "}"
    ],
    "description": "Condición con alternativa"
  },
  "for con rango": {
    "prefix": [
      "for",
      "para"
    ],
    "body": [
      "for ${1:i} in ${2:0}..${3:10} {",
      "\t$0",
      "}"
    ],
    "description": "Bucle numérico (fin excluido; usa ..= para incluirlo)"
  },
  "foreach": {
    "prefix": [
      "foreach",
      "paracada"
    ],
    "body": [
      "foreach ${1:elemento} in ${2:lista} {",
      "\t$0",
      "}"
    ],
    "description": "Recorre una lista, mapa, conjunto o texto"
  },
  "while": {
    "prefix": [
      "while",
      "mientras"
    ],
    "body": [
      "while ${1:condicion} {",
      "\t$0",
      "}"
    ],
    "description": "Bucle mientras se cumpla la condición"
  },
  "repeat": {
    "prefix": [
      "repeat",
      "repetir"
    ],
    "body": [
      "repeat ${1:3} {",
      "\t$0",
      "}"
    ],
    "description": "Repite un bloque N veces"
  },
  "match": {
    "prefix": [
      "match",
      "segun"
    ],
    "body": [
      "match ${1:valor} {",
      "\t${2:1} => ${3:\"uno\"}",
      "\t${4:2, 3} => ${5:\"dos o tres\"}",
      "\telse => ${0:\"otro\"}",
      "}"
    ],
    "description": "Elige un resultado según el valor"
  },
  "try / catch": {
    "prefix": [
      "try",
      "intentar"
    ],
    "body": [
      "try {",
      "\t$1",
      "} catch e {",
      "\tprint(\"Error:\", e.message)$0",
      "}"
    ],
    "description": "Captura errores"
  },
  "Evento": {
    "prefix": [
      "event",
      "evento"
    ],
    "body": [
      "event ${1:Golpe}(${2:objetivo}: ${3:text}, ${4:danio}: ${5:number})",
      "",
      "on ${1:Golpe} as e {",
      "\t$0",
      "}"
    ],
    "description": "Declara un evento y un manejador"
  },
  "Manejador on": {
    "prefix": [
      "on"
    ],
    "body": [
      "on ${1:Evento} as e {",
      "\t$0",
      "}"
    ],
    "description": "Escucha un evento"
  },
  "Emitir evento": {
    "prefix": [
      "emit",
      "emitir"
    ],
    "body": [
      "emit ${1:Evento}(${0})"
    ],
    "description": "Lanza un evento"
  },
  "Importar": {
    "prefix": [
      "from",
      "importar"
    ],
    "body": [
      "from \"./${1:modulo}.hz\" import ${0:Nombre}"
    ],
    "description": "Importa nombres de otro archivo"
  },
  "Prueba": {
    "prefix": [
      "test",
      "prueba"
    ],
    "body": [
      "test(\"${1:descripción}\", () => {",
      "\tassertEqual(${2:actual}, ${3:esperado})$0",
      "})"
    ],
    "description": "Prueba unitaria (se ejecuta con hyper test)"
  },
  "Bucle de juego de consola": {
    "prefix": [
      "juego",
      "gameloop"
    ],
    "body": [
      "var jugando = true",
      "var x = 0",
      "while jugando {",
      "\tConsole.clear()",
      "\tConsole.print(\" \".repeat(x) + \"@\", \"cyan\")",
      "\tConsole.print(\"← → para moverte, Esc para salir\", \"gray\")",
      "\tvar tecla = Console.readKey()",
      "\tmatch tecla {",
      "\t\t\"left\" => x = max(0, x - 1)",
      "\t\t\"right\" => x = min(Console.width - 1, x + 1)",
      "\t\t\"escape\" => jugando = false",
      "\t\telse => null",
      "\t}",
      "}",
      "$0"
    ],
    "description": "Esqueleto de un juego de consola controlado con el teclado"
  },
  "Tarea en segundo plano": {
    "prefix": [
      "spawn",
      "temporizador"
    ],
    "body": [
      "spawn(async () => {",
      "\twhile true {",
      "\t\tawait wait(${1:1})",
      "\t\t$0",
      "\t}",
      "})"
    ],
    "description": "Repite algo cada N segundos sin bloquear"
  },
  "Desestructurar lista": {
    "prefix": [
      "desestructurar",
      "var["
    ],
    "body": [
      "var [${1:a}, ${2:b}] = ${3:lista}"
    ],
    "description": "Saca varios valores de una lista"
  },
  "Desestructurar mapa": {
    "prefix": [
      "var{"
    ],
    "body": [
      "var {${1:nombre}, ${2:vida}} = ${3:jugador}"
    ],
    "description": "Saca varios campos de un mapa u objeto"
  },
  "Servidor web": {
    "prefix": [
      "servidor",
      "web"
    ],
    "body": [
      "import web",
      "",
      "var app = web.App()",
      "app.get(\"/\", req => \"<h1>${1:Hola desde HyperEZ}</h1>\")",
      "app.get(\"/api/${2:datos}/:id\", req => ({ id: req.params.id }))",
      "app.post(\"/api/${2:datos}\", req => ({ status: 201, json: req.json }))",
      "app.listen(${3:8080})"
    ],
    "description": "Aplicación web con rutas (import web)"
  },
  "Red neuronal": {
    "prefix": [
      "red",
      "ia",
      "neuronal"
    ],
    "body": [
      "import ai",
      "",
      "randomSeed(1)",
      "var red = ai.NeuralNetwork([${1:2}, ${2:8}, ${3:1}])",
      "var error = red.train(${4:entradas}, ${5:esperado}, ${6:1000}, ${7:0.5})",
      "print(\"error:\", error)",
      "print(red.predict(${8:[1, 0]}))"
    ],
    "description": "Red neuronal con la biblioteca ai"
  },
  "Imagen": {
    "prefix": [
      "imagen",
      "image"
    ],
    "body": [
      "var im = Image(${1:400}, ${2:300}, \"${3:#ffffff}\")",
      "im.rect(${4:20}, ${5:20}, ${6:100}, ${7:60}, \"#2f81f7\")",
      "im.text(20, 100, \"${8:HyperEZ}\", \"#1f2328\", 24)",
      "im.save(\"${9:imagen.png}\")"
    ],
    "description": "Dibujar y guardar una imagen"
  },
  "Sonido": {
    "prefix": [
      "sonido",
      "audio"
    ],
    "body": [
      "import audio",
      "",
      "var s = audio.Sound()",
      "s.melody(\"${1:C4 E4 G4 C5}\", ${2:0.25})",
      "s.save(\"${3:sonido.wav}\")"
    ],
    "description": "Crear un sonido WAV"
  },
  "Base de datos": {
    "prefix": [
      "db",
      "basedatos"
    ],
    "body": [
      "import db",
      "",
      "var base = db.Database(\"${1:datos.json}\")",
      "var ${2:jugadores} = base.collection(\"${2:jugadores}\")",
      "${2:jugadores}.insert({ ${3:nombre: \"Ana\"} })",
      "print(${2:jugadores}.find(${4:x => true}))"
    ],
    "description": "Base de datos de documentos"
  },
  "Petición HTTP": {
    "prefix": [
      "http",
      "peticion"
    ],
    "body": [
      "var ${1:datos} = Http.getJson(\"${2:https://api.github.com/repos/microsoft/vscode}\")",
      "print(${1:datos})"
    ],
    "description": "Pedir JSON a un servicio web"
  },
  "Expresión regular": {
    "prefix": [
      "regex",
      "patron"
    ],
    "body": [
      "var ${1:re} = Regex(r\"${2:\\\\d+}\")",
      "foreach m in ${1:re}.findAll(${3:texto}) { print(m.text) }"
    ],
    "description": "Buscar un patrón en un texto"
  },
  "Ejecutar programa": {
    "prefix": [
      "proceso",
      "process"
    ],
    "body": [
      "var r = Process.run(\"${1:git}\", [${2:\"--version\"}])",
      "print(r.ok, r.output)"
    ],
    "description": "Ejecutar otro programa y leer su salida"
  },
  "Leer CSV": {
    "prefix": [
      "csv"
    ],
    "body": [
      "import csv",
      "",
      "var filas = csv.read(\"${1:datos.csv}\")",
      "foreach f in filas { print(f.${2:nombre}) }"
    ],
    "description": "Leer una tabla CSV"
  },
  "Argumentos de la herramienta": {
    "prefix": [
      "args",
      "cli"
    ],
    "body": [
      "import cli",
      "",
      "var a = cli.parseArgs(System.args)",
      "var archivo = a.positional.length > 0 ? a.positional[0] : \"${1:entrada.txt}\"",
      "var detalle = a.flags.contains(\"v\")"
    ],
    "description": "Leer argumentos: hyper programa.hz archivo --opcion valor -v"
  },
  "Operador en clase": {
    "prefix": [
      "operador",
      "operator"
    ],
    "body": [
      "function ${1|add,sub,mul,div,mod,pow|}(otro: ${2:Tipo}): ${2:Tipo} {",
      "\treturn ${0}",
      "}"
    ],
    "description": "Sobrecarga de un operador (+ - * / % **) en una clase"
  },
  "Sector de arranque": {
    "prefix": [
      "arranque",
      "bootsector"
    ],
    "body": [
      "import x86",
      "",
      "var a = x86.Assembler(0x7C00)",
      "a.xorReg16(\"ax\", \"ax\").movSeg(\"ds\", \"ax\")",
      "a.printString(\"mensaje\")",
      "a.label(\"fin\").cli().hlt().jmp(\"fin\")",
      "a.label(\"mensaje\").db(\"${1:Hola}\", 0)",
      "File.writeBytes(\"${2:arranque.img}\", x86.bootSector(a))"
    ],
    "description": "Sector de arranque x86 (qemu-system-x86_64)"
  },
  "Grafo y camino más corto": {
    "prefix": [
      "grafo",
      "graph",
      "dijkstra"
    ],
    "body": [
      "import collections",
      "",
      "var ${1:mapa} = collections.Graph()",
      "${1:mapa}.addEdge(\"${2:A}\", \"${3:B}\", ${4:10})",
      "print(${1:mapa}.shortestPath(\"${2:A}\", \"${3:B}\"))"
    ],
    "description": "Grafo con pesos y camino más corto (import collections)"
  },
  "Cola de prioridad": {
    "prefix": [
      "colaprioridad",
      "priorityqueue"
    ],
    "body": [
      "import collections",
      "",
      "var ${1:cola} = collections.PriorityQueue()",
      "${1:cola}.push(\"${2:tarea}\", ${3:1})",
      "while not ${1:cola}.isEmpty() { print(${1:cola}.pop()) }"
    ],
    "description": "Cola de prioridad: sale antes la prioridad más baja"
  },
  "Camino en una cuadrícula (A*)": {
    "prefix": [
      "camino",
      "astar",
      "laberinto"
    ],
    "body": [
      "import algo",
      "",
      "var mapa = [\"S..#\",",
      "            \".#..\",",
      "            \"...G\"]",
      "var camino = algo.gridPath(mapa, [0, 0], [3, 2])",
      "foreach fila in algo.drawPath(mapa, camino) { print(fila) }"
    ],
    "description": "Camino más corto en una cuadrícula con A* (import algo)"
  },
  "Plantilla de texto": {
    "prefix": [
      "plantilla",
      "template"
    ],
    "body": [
      "import template",
      "",
      "var texto = template.render(\"Hola, {{nombre}}.\\n{{#each items}}\\n- {{this}}\\n{{/each}}\", { nombre: \"${1:Ana}\", items: [${2:\"uno\", \"dos\"}] })",
      "print(texto)"
    ],
    "description": "Rellenar una plantilla con datos (import template)"
  },
  "Markdown a HTML": {
    "prefix": [
      "markdown",
      "md"
    ],
    "body": [
      "import markdown",
      "",
      "File.write(\"${1:pagina.html}\", markdown.page(\"${2:Título}\", \"# ${2:Título}\\n\\n${3:Texto con **negrita**.}\"))"
    ],
    "description": "Página HTML a partir de Markdown (import markdown)"
  },
  "Crear un zip": {
    "prefix": [
      "zip",
      "comprimir"
    ],
    "body": [
      "import zip",
      "",
      "zip.create(\"${1:copia.zip}\", { \"${2:notas.txt}\": \"${3:contenido}\" })",
      "print(zip.list(\"${1:copia.zip}\"))"
    ],
    "description": "Crear y listar un archivo .zip (import zip)"
  },
  "Gráfica SVG": {
    "prefix": [
      "grafica",
      "svg",
      "chart"
    ],
    "body": [
      "import svg",
      "",
      "svg.barChart({ ${1:ene: 120, feb: 95, mar: 160} }, { title: \"${2:Ventas}\" }).save(\"${3:grafica.svg}\")"
    ],
    "description": "Gráfica de barras en SVG (import svg)"
  },
  "Registro de mensajes": {
    "prefix": [
      "log",
      "registro"
    ],
    "body": [
      "import log",
      "",
      "var ${1:registro} = log.Logger(\"${2:app}\", \"info\")",
      "${1:registro}.info(\"${3:Arrancando}\")"
    ],
    "description": "Registro con niveles y colores (import log)"
  },
  "Comprensión de lista": {
    "prefix": [
      "comprension",
      "lista por"
    ],
    "body": [
      "[${1:x * 2} for ${2:x} in ${3:lista}${4: if ${5:x > 0}}]"
    ],
    "description": "Lista nueva a partir de otra: [x * 2 for x in lista if x > 0]"
  },
  "Tubería": {
    "prefix": [
      "tuberia",
      "pipe"
    ],
    "body": [
      "${1:valor}\n    |> ${2:paso1}\n    |> ${3:paso2}"
    ],
    "description": "Encadenar pasos: valor |> f es f(valor)"
  },
  "Aplicación web con plantillas": {
    "prefix": [
      "webapp",
      "aplicacionweb"
    ],
    "body": [
      "import web",
      "",
      "var app = web.App()",
      "app.staticDir(\"/publico\", \"publico\")",
      "app.get(\"/\", req => web.view(\"plantillas/inicio.html\", { titulo: \"${1:Inicio}\" }))",
      "app.post(\"/enviar\", req => web.html(\"Gracias, \" + web.form(req).get(\"nombre\", \"\")))",
      "app.listen(${2:8080}, { open: true })"
    ],
    "description": "Web con archivos estáticos, plantillas y un formulario (import web)"
  },
  "Sitio desde Markdown": {
    "prefix": [
      "sitio",
      "site"
    ],
    "body": [
      "import site",
      "",
      "site.build(\"${1:contenido}\", \"${2:web}\", { title: \"${3:Mi web}\" })",
      "// míralo con: hyper serve ${2:web}"
    ],
    "description": "Web estática a partir de archivos Markdown (import site)"
  },
  "Bucle do-while": {
    "prefix": [
      "hacer",
      "do"
    ],
    "body": [
      "do {",
      "\t${1:// se ejecuta al menos una vez}",
      "} while ${2:condicion}"
    ],
    "description": "do { } while: repite el bloque mientras se cumpla la condición (al menos una vez)"
  },
  "Texto con formato": {
    "prefix": [
      "formato",
      "fmt"
    ],
    "body": [
      "print(\"\\${${1:nombre}:<${2:10}} \\${${3:precio}:>${4:8}.2f}\")"
    ],
    "description": "Texto con formato: ${nombre:<10} alinea a la izquierda y ${precio:>8.2f} pone 2 decimales a la derecha"
  }
}
