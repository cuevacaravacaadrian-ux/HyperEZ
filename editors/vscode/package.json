{
  "name": "hyperez",
  "displayName": "HyperEZ",
  "description": "Lenguaje de programación en español para hacer de todo: juegos, IA, web, datos, gráficos y sistemas. Errores en vivo, autocompletado, F5 para ejecutar, modo watch, consola interactiva, tema y tutorial.",
  "version": "0.8.0",
  "publisher": "hyperez",
  "license": "MIT",
  "author": {
    "name": "Adrián Cueva Caravaca"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/cuevacaravacaadrian-ux/HyperEZ.git",
    "directory": "editors/vscode"
  },
  "bugs": {
    "url": "https://github.com/cuevacaravacaadrian-ux/HyperEZ/issues"
  },
  "homepage": "https://github.com/cuevacaravacaadrian-ux/HyperEZ#readme",
  "icon": "icons/hyperez-128.png",
  "galleryBanner": {
    "color": "#0f1424",
    "theme": "dark"
  },
  "engines": {
    "vscode": "^1.75.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets",
    "Linters",
    "Themes",
    "Education",
    "Testing"
  ],
  "keywords": [
    "hyperez",
    "hz",
    "hez",
    "español",
    "spanish",
    "aprender",
    "educación",
    "juegos",
    "games",
    "ia",
    "inteligencia artificial",
    "lenguaje",
    "language server",
    "repl"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:hyperez",
    "workspaceContains:**/*.hz",
    "workspaceContains:**/*.hez",
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "En espacios no confiables no se ejecutan programas."
    }
  },
  "contributes": {
    "languages": [
      {
        "id": "hyperez",
        "aliases": [
          "HyperEZ",
          "hyperez",
          "hz"
        ],
        "extensions": [
          ".hez",
          ".hz"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/hz-file.svg",
          "dark": "./icons/hz-file.svg"
        }
      }
    ],
    "grammars": [
      {
        "language": "hyperez",
        "scopeName": "source.hyperez",
        "path": "./syntaxes/hyperez.tmLanguage.json"
      },
      {
        "scopeName": "markdown.hyperez.codeblock",
        "path": "./syntaxes/hyperez.markdown.json",
        "injectTo": [
          "text.html.markdown"
        ],
        "embeddedLanguages": {
          "meta.embedded.block.hyperez": "hyperez"
        }
      }
    ],
    "snippets": [
      {
        "language": "hyperez",
        "path": "./snippets/hyperez.json"
      }
    ],
    "commands": [
      {
        "command": "hyperez.run",
        "title": "Ejecutar archivo",
        "category": "HyperEZ",
        "icon": "$(play)"
      },
      {
        "command": "hyperez.watch",
        "title": "Ejecutar y repetir al guardar (watch)",
        "category": "HyperEZ",
        "icon": "$(sync)"
      },
      {
        "command": "hyperez.repl",
        "title": "Abrir consola interactiva",
        "category": "HyperEZ",
        "icon": "$(terminal)"
      },
      {
        "command": "hyperez.check",
        "title": "Comprobar errores",
        "category": "HyperEZ",
        "icon": "$(check)"
      },
      {
        "command": "hyperez.test",
        "title": "Ejecutar pruebas",
        "category": "HyperEZ",
        "icon": "$(beaker)"
      },
      {
        "command": "hyperez.newProject",
        "title": "Nuevo proyecto",
        "category": "HyperEZ"
      },
      {
        "command": "hyperez.showDocs",
        "title": "Abrir la referencia de la API",
        "category": "HyperEZ",
        "icon": "$(book)"
      },
      {
        "command": "hyperez.restartServer",
        "title": "Reiniciar el servidor de lenguaje",
        "category": "HyperEZ"
      },
      {
        "command": "hyperez.showVersion",
        "title": "Mostrar versión",
        "category": "HyperEZ"
      },
      {
        "command": "hyperez.newFile",
        "title": "Nuevo archivo HyperEZ",
        "category": "HyperEZ",
        "icon": "$(new-file)"
      },
      {
        "command": "hyperez.openWalkthrough",
        "title": "Empezar con HyperEZ (tutorial)",
        "category": "HyperEZ",
        "icon": "$(rocket)"
      },
      {
        "command": "hyperez.openGuide",
        "title": "Abrir la guía del lenguaje",
        "category": "HyperEZ",
        "icon": "$(book)"
      },
      {
        "command": "hyperez.openExamples",
        "title": "Abrir los ejemplos",
        "category": "HyperEZ",
        "icon": "$(folder-library)"
      },
      {
        "command": "hyperez.openInEditor",
        "title": "Abrir en HyperEZ Editor",
        "category": "HyperEZ",
        "icon": "$(edit)"
      },
      {
        "command": "hyperez.showBytecode",
        "title": "Ver el bytecode del archivo",
        "category": "HyperEZ",
        "icon": "$(list-ordered)"
      },
      {
        "command": "hyperez.format",
        "title": "Dar formato al archivo (hyper fmt)",
        "category": "HyperEZ",
        "icon": "$(symbol-ruler)"
      },
      {
        "command": "hyperez.runTests",
        "title": "Ejecutar las pruebas de este archivo",
        "category": "HyperEZ",
        "icon": "$(beaker)"
      }
    ],
    "menus": {
      "editor/title/run": [
        {
          "command": "hyperez.run",
          "when": "resourceLangId == hyperez",
          "group": "navigation@0"
        },
        {
          "command": "hyperez.watch",
          "when": "resourceLangId == hyperez",
          "group": "navigation@1"
        }
      ],
      "editor/context": [
        {
          "command": "hyperez.run",
          "when": "resourceLangId == hyperez",
          "group": "hyperez@1"
        },
        {
          "command": "hyperez.watch",
          "when": "resourceLangId == hyperez",
          "group": "hyperez@1"
        },
        {
          "command": "hyperez.check",
          "when": "resourceLangId == hyperez",
          "group": "hyperez@2"
        },
        {
          "command": "hyperez.format",
          "when": "resourceLangId == hyperez",
          "group": "hyperez@3"
        },
        {
          "command": "hyperez.showBytecode",
          "when": "resourceLangId == hyperez",
          "group": "hyperez@4"
        },
        {
          "command": "hyperez.openInEditor",
          "when": "resourceLangId == hyperez && isWindows",
          "group": "hyperez@4"
        }
      ],
      "explorer/context": [
        {
          "command": "hyperez.newFile",
          "when": "explorerResourceIsFolder",
          "group": "navigation@9"
        },
        {
          "command": "hyperez.run",
          "when": "resourceExtname =~ /^\\.(hz|hez)$/",
          "group": "hyperez@1"
        },
        {
          "command": "hyperez.watch",
          "when": "resourceExtname =~ /^\\.(hz|hez)$/",
          "group": "hyperez@1"
        },
        {
          "command": "hyperez.check",
          "when": "resourceExtname =~ /^\\.(hz|hez)$/",
          "group": "hyperez@2"
        },
        {
          "command": "hyperez.openInEditor",
          "when": "resourceExtname =~ /^\\.(hz|hez)$/ && isWindows",
          "group": "hyperez@3"
        }
      ],
      "commandPalette": [
        {
          "command": "hyperez.run",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.check",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.watch",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.format",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.showBytecode",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.openInEditor",
          "when": "editorLangId == hyperez"
        },
        {
          "command": "hyperez.runTests",
          "when": "editorLangId == hyperez"
        }
      ]
    },
    "keybindings": [
      {
        "command": "hyperez.run",
        "key": "f5",
        "when": "editorLangId == hyperez && !inDebugMode"
      },
      {
        "command": "hyperez.run",
        "key": "ctrl+f5",
        "mac": "cmd+f5",
        "when": "editorLangId == hyperez && !inDebugMode"
      },
      {
        "command": "hyperez.check",
        "key": "ctrl+shift+f5",
        "when": "editorLangId == hyperez"
      },
      {
        "command": "hyperez.watch",
        "key": "ctrl+alt+f5",
        "mac": "cmd+alt+f5",
        "when": "editorLangId == hyperez && !inDebugMode"
      },
      {
        "command": "hyperez.format",
        "key": "shift+alt+f",
        "when": "editorLangId == hyperez && editorTextFocus"
      }
    ],
    "configuration": {
      "title": "HyperEZ",
      "properties": {
        "hyperez.path": {
          "type": "string",
          "default": "",
          "markdownDescription": "Ruta de `hyper.exe`. Si se deja vacía se usa la instalación de HyperEZ, el `PATH` o la copia incluida en la extensión."
        },
        "hyperez.languageServer.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Errores en vivo, autocompletado, documentación y renombrar (servidor de lenguaje)."
        },
        "hyperez.run.saveBeforeRun": {
          "type": "boolean",
          "default": true,
          "description": "Guardar el archivo antes de ejecutarlo."
        },
        "hyperez.run.reuseTerminal": {
          "type": "boolean",
          "default": true,
          "description": "Cerrar la terminal de la ejecución anterior al volver a ejecutar."
        },
        "hyperez.colorDecorators": {
          "type": "boolean",
          "default": true,
          "description": "Mostrar muestras de color para \"#ff8800\" y Color(r, g, b)."
        },
        "hyperez.codeLens": {
          "type": "boolean",
          "default": true,
          "description": "Muestra «▶ Ejecutar · ⟳ Repetir al guardar · ✓ Comprobar» encima del código y «▶ Probar» encima de cada test(...)."
        },
        "hyperez.formatOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Da formato al archivo (hyper fmt: sangría y espacios) cada vez que se guarda."
        }
      }
    },
    "problemMatchers": [
      {
        "name": "hyperez",
        "owner": "hyperez",
        "source": "hyperez",
        "fileLocation": [
          "autoDetect",
          "${workspaceFolder}"
        ],
        "pattern": [
          {
            "regexp": "^(error|aviso)(?:\\[([EW]\\d+)\\])?: (.*)$",
            "severity": 1,
            "code": 2,
            "message": 3
          },
          {
            "regexp": "^\\s*--> (.+):(\\d+):(\\d+)$",
            "file": 1,
            "line": 2,
            "column": 3
          }
        ],
        "severity": "error"
      }
    ],
    "taskDefinitions": [
      {
        "type": "hyperez",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "run",
              "check",
              "test"
            ],
            "description": "Comando de hyper"
          },
          "file": {
            "type": "string",
            "description": "Archivo o carpeta"
          }
        }
      }
    ],
    "themes": [
      {
        "label": "HyperEZ Noche",
        "uiTheme": "vs-dark",
        "path": "./themes/hyperez-noche-color-theme.json"
      }
    ],
    "walkthroughs": [
      {
        "id": "empezar",
        "title": "Empezar con HyperEZ",
        "description": "Escribe, ejecuta y prueba tu primer programa en HyperEZ en cinco pasos.",
        "steps": [
          {
            "id": "hola",
            "title": "Escribe tu primer programa",
            "description": "Crea un archivo .hz y escribe un saludo.\n[Nuevo archivo HyperEZ](command:hyperez.newFile)",
            "media": {
              "markdown": "walkthrough/1-hola.md"
            },
            "completionEvents": [
              "onCommand:hyperez.newFile",
              "onLanguage:hyperez"
            ]
          },
          {
            "id": "ejecutar",
            "title": "Ejecútalo con F5",
            "description": "F5 ejecuta; Ctrl+Alt+F5 vuelve a ejecutar cada vez que guardas.\n[Ejecutar](command:hyperez.run)",
            "media": {
              "markdown": "walkthrough/2-ejecutar.md"
            },
            "completionEvents": [
              "onCommand:hyperez.run",
              "onCommand:hyperez.watch"
            ]
          },
          {
            "id": "consola",
            "title": "Prueba la consola interactiva",
            "description": "Escribe código y ve el resultado al momento.\n[Abrir la consola](command:hyperez.repl)",
            "media": {
              "markdown": "walkthrough/3-consola.md"
            },
            "completionEvents": [
              "onCommand:hyperez.repl"
            ]
          },
          {
            "id": "proyecto",
            "title": "Crea un proyecto",
            "description": "Un juego, una app, una IA o una herramienta, con su estructura de carpetas.\n[Nuevo proyecto](command:hyperez.newProject)",
            "media": {
              "markdown": "walkthrough/4-proyecto.md"
            },
            "completionEvents": [
              "onCommand:hyperez.newProject"
            ]
          },
          {
            "id": "aprender",
            "title": "Sigue aprendiendo",
            "description": "La guía, la referencia de la API y el tema HyperEZ Noche.\n[Abrir la guía](command:hyperez.openGuide)",
            "media": {
              "markdown": "walkthrough/5-aprender.md"
            },
            "completionEvents": [
              "onCommand:hyperez.openGuide",
              "onCommand:hyperez.showDocs"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "bundle": "node tools/bundle.js",
    "vscode:prepublish": "node tools/bundle.js",
    "package": "vsce package --no-dependencies --allow-missing-repository --allow-star-activation -o hyperez-0.8.0.vsix",
    "test": "node test/grammar.test.js",
    "test:vscode": "node test/runTest.js"
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "devDependencies": {
    "@vscode/test-electron": "^3.1.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.28.2",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0"
  },
  "pricing": "Free",
  "qna": "https://github.com/cuevacaravacaadrian-ux/HyperEZ/issues"
}
