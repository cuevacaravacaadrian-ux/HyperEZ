{
  "$schema": "vscode://schemas/color-theme",
  "name": "HyperEZ Noche",
  "type": "dark",
  "colors": {
    "editor.background": "#0f1424",
    "editor.foreground": "#d6deeb",
    "editorLineNumber.foreground": "#3b4766",
    "editorLineNumber.activeForeground": "#8aa2d3",
    "editorCursor.foreground": "#58a6ff",
    "editor.selectionBackground": "#2a3a63",
    "editor.lineHighlightBackground": "#151c33",
    "editor.findMatchHighlightBackground": "#58a6ff33",
    "editorIndentGuide.background1": "#1f2945",
    "editorBracketMatch.background": "#58a6ff22",
    "editorBracketMatch.border": "#58a6ff88",
    "editorError.foreground": "#ff6b81",
    "editorWarning.foreground": "#ffc857",
    "editorGutter.background": "#0f1424",
    "sideBar.background": "#0c1120",
    "sideBar.foreground": "#aab6d3",
    "sideBarTitle.foreground": "#d6deeb",
    "sideBarSectionHeader.background": "#111830",
    "activityBar.background": "#0a0e1a",
    "activityBar.foreground": "#d6deeb",
    "activityBarBadge.background": "#58a6ff",
    "statusBar.background": "#0a0e1a",
    "statusBar.foreground": "#aab6d3",
    "statusBarItem.remoteBackground": "#2f81f7",
    "titleBar.activeBackground": "#0a0e1a",
    "titleBar.activeForeground": "#d6deeb",
    "tab.activeBackground": "#0f1424",
    "tab.inactiveBackground": "#0c1120",
    "tab.activeBorderTop": "#58a6ff",
    "editorGroupHeader.tabsBackground": "#0c1120",
    "panel.background": "#0c1120",
    "panel.border": "#1f2945",
    "terminal.background": "#0c1120",
    "terminal.foreground": "#d6deeb",
    "terminal.ansiBlue": "#58a6ff",
    "terminal.ansiCyan": "#56d4dd",
    "terminal.ansiGreen": "#7ee787",
    "terminal.ansiYellow": "#ffc857",
    "terminal.ansiRed": "#ff6b81",
    "terminal.ansiMagenta": "#d2a8ff",
    "button.background": "#2f81f7",
    "focusBorder": "#58a6ff",
    "list.activeSelectionBackground": "#1f2f57",
    "list.hoverBackground": "#151c33",
    "input.background": "#111830",
    "dropdown.background": "#111830",
    "widget.shadow": "#00000080"
  },
  "tokenColors": [
    { "scope": ["comment", "punctuation.definition.comment"], "settings": { "foreground": "#5f7099", "fontStyle": "italic" } },
    { "scope": ["comment.line.triple-slash.documentation", "comment.block.documentation"], "settings": { "foreground": "#7f93c4", "fontStyle": "italic" } },
    { "scope": ["keyword", "keyword.control", "storage.type", "storage.modifier"], "settings": { "foreground": "#c792ea" } },
    { "scope": ["keyword.operator", "punctuation.separator"], "settings": { "foreground": "#89ddff" } },
    { "scope": ["string", "punctuation.definition.string"], "settings": { "foreground": "#7ee787" } },
    { "scope": ["string.quoted.raw"], "settings": { "foreground": "#a5e8a0" } },
    { "scope": ["constant.character.escape"], "settings": { "foreground": "#ffc857" } },
    { "scope": ["punctuation.section.interpolation", "meta.interpolation punctuation"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["constant.numeric"], "settings": { "foreground": "#f78c6c" } },
    { "scope": ["constant.language", "variable.other.constant"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["entity.name.function", "support.function"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.function.member"], "settings": { "foreground": "#82aaff" } },
    { "scope": ["entity.name.type", "entity.other.inherited-class", "support.type", "support.class"], "settings": { "foreground": "#ffcb6b" } },
    { "scope": ["support.class.builtin"], "settings": { "foreground": "#56d4dd" } },
    { "scope": ["variable.parameter"], "settings": { "foreground": "#f2c6a0", "fontStyle": "italic" } },
    { "scope": ["variable.language.this", "variable.language"], "settings": { "foreground": "#ff6b81", "fontStyle": "italic" } },
    { "scope": ["variable.other.property"], "settings": { "foreground": "#b2ccd6" } },
    { "scope": ["variable", "variable.other.readwrite"], "settings": { "foreground": "#d6deeb" } },
    { "scope": ["entity.name.function.event"], "settings": { "foreground": "#ff9e64" } },
    { "scope": ["markup.heading"], "settings": { "foreground": "#82aaff", "fontStyle": "bold" } },
    { "scope": ["markup.bold"], "settings": { "fontStyle": "bold" } },
    { "scope": ["markup.italic"], "settings": { "fontStyle": "italic" } },
    { "scope": ["markup.inline.raw", "markup.fenced_code"], "settings": { "foreground": "#7ee787" } },
    { "scope": ["invalid"], "settings": { "foreground": "#ff6b81" } }
  ]
}
