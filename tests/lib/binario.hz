// Bytes, Hash y Base64.

test("Bytes: crear, leer y escribir", () => {
    var b = Bytes([1, 2, 3])
    assertEqual(b.length, 3)
    assertEqual(len(b), 3)
    assertEqual(b[0], 1)
    assertEqual(b[-1], 3)
    b[1] = 200
    assertEqual(b.toList(), [1, 200, 3])
    assertEqual(Bytes(4, 7).toList(), [7, 7, 7, 7])
    assertEqual(Bytes("Hola").toList(), [72, 111, 108, 97])
    assertEqual(Bytes("¡Hola!").toText(), "¡Hola!")
    assertThrows(() => b[5])
    assertThrows(() => { b[0] = 300 })
})

test("Bytes: enteros y decimales en little y big endian", () => {
    var b = Bytes(16)
    b.writeU16(0, 0x1234)
    assertEqual(b.toHex().substring(0, 4), "3412")
    assertEqual(b.readU16(0), 0x1234)
    assertEqual(b.readU16(0, false), 0x3412)
    b.writeU32(2, 4000000000)
    assertEqual(b.readU32(2), 4000000000)
    assertEqual(b.readI32(2), 4000000000 - 4294967296)
    b.writeF64(8, -2.5)
    assertEqual(b.readF64(8), -2.5)
    var c = Bytes()
    c.push(0xFF).pushU16(1).pushU32(2, false).pushF32(1.5)
    assertEqual(c.toHex(" "), "ff 01 00 00 00 00 02 00 00 c0 3f")
    assertEqual(c.readI8(0), -1)
    assertEqual(c.readF32(7), 1.5)
})

test("Bytes: partes, búsqueda y conversiones", () => {
    var b = Bytes("abcdef")
    assertEqual(b.slice(1, 3).toText(), "bc")
    assertEqual(b.slice(-2).toText(), "ef")
    assertEqual(b.concat("gh").toText(), "abcdefgh")
    assertEqual(b.indexOf("cd"), 2)
    assertEqual(b.indexOf(0x66), 5)
    assertEqual(b.indexOf("zz"), -1)
    assertEqual(Bytes.fromHex("de:ad:be:ef").toList(), [222, 173, 190, 239])
    assertEqual(b.toBase64(), "YWJjZGVm")
    assertEqual(Bytes.fromBase64("YWJjZGVm").toText(), "abcdef")
    assertEqual(b == Bytes("abcdef"), true)
    assertEqual(b != Bytes("abc"), true)
    assertEqual(b.copy().fill(0).toList(), [0, 0, 0, 0, 0, 0])
    assertEqual(Bytes(2).resize(4).length, 4)
    assertEqual(str(Bytes([1, 255])), "Bytes(2: 01 ff)")
})

test("File.readBytes y writeBytes", () => {
    var ruta = Path.join(Path.temp, "hz_bytes_" + str(Process.pid) + ".bin")
    File.writeBytes(ruta, Bytes([0, 1, 2, 254, 255]))
    assertEqual(File.readBytes(ruta).toList(), [0, 1, 2, 254, 255])
    assertEqual(File.size(ruta), 5)
    File.delete(ruta)
})

test("Hash: valores conocidos", () => {
    assertEqual(Hash.sha256(""), "e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855")
    assertEqual(Hash.sha256("abc"), "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad")
    assertEqual(Hash.sha256("abcdbcdecdefdefgefghfghighijhijkijkljklmklmnlmnomnopnopq"),
                "248d6a61d20638b8e5c026930c3e6039a33ce45964ff2167f6ecedd419db06c1")
    assertEqual(Hash.sha256Bytes("abc").length, 32)
    assertEqual(Hash.crc32("123456789"), 0xCBF43926)
    assertEqual(Hash.fnv1a("a"), 0xE40C292C)
    assertEqual(Hash.sha256(Bytes("abc")), Hash.sha256("abc"))
    var u = Hash.uuid()
    assertEqual(u.length, 36)
    assertEqual(u[14], "4")
    assert(u != Hash.uuid(), "cada uuid es distinto")
})

test("Base64", () => {
    assertEqual(Base64.encode(""), "")
    assertEqual(Base64.encode("f"), "Zg==")
    assertEqual(Base64.encode("fo"), "Zm8=")
    assertEqual(Base64.encode("foo"), "Zm9v")
    assertEqual(Base64.encode("¡Hola!"), "wqFIb2xhIQ==")
    assertEqual(Base64.decode("Zm9vYmFy"), "foobar")
    assertEqual(Base64.decodeBytes("AP8=").toList(), [0, 255])
    assertThrows(() => Base64.decode("no es *base64*"))
})
