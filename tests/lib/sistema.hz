// Process, Path, File y Time.

test("Process.shell y Process.run", () => {
    var r = Process.shell("echo hola")
    assertEqual(r.ok, true)
    assertEqual(r.code, 0)
    assertEqual(r.output.trim(), "hola")
    var v = Process.run(System.exe, ["version"])
    assert(v.output.startsWith("HyperEZ "), "hyper version")
    var fallo = Process.run(System.exe, ["comando-que-no-existe"])
    assertEqual(fallo.ok, false)
    assert(fallo.code != 0)
    assertThrows(() => Process.run("programa-que-no-existe-hz"))
})

test("Process con entrada, carpeta y variables", () => {
    var tmp = Path.join(Path.temp, "hz_proc_" + str(Process.pid))
    File.makeDir(tmp)
    File.write(Path.join(tmp, "eco.hz"), "print(input()); print(System.env(\"HZ_PRUEBA\")); print(File.exists(\"eco.hz\"))")
    var r = Process.run(System.exe, ["eco.hz"], { cwd: tmp, input: "desde la entrada\n", env: { HZ_PRUEBA: "valor" } })
    assertEqual(r.output.lines().map(l => l.trim()).take(3), ["desde la entrada", "valor", "true"])
    File.write(Path.join(tmp, "dormir.hz"), "System.sleep(5)")
    var lento = Process.run(System.exe, ["dormir.hz"], { cwd: tmp, timeout: 0.5 })
    assertEqual(lento.timedOut, true)
    assertEqual(lento.ok, false)
    File.deleteDir(tmp)
})

test("Path", () => {
    assertEqual(Path.join("a", "b", "c.txt"), "a/b/c.txt")
    assertEqual(Path.dir("a/b/c.txt"), "a/b")
    assertEqual(Path.name("a/b/c.txt"), "c.txt")
    assertEqual(Path.stem("a/b/c.txt"), "c")
    assertEqual(Path.ext("a/b/c.txt"), ".txt")
    assertEqual(Path.withExt("juego.hz", "json"), "juego.json")
    assertEqual(Path.normalize("a/./b/../c"), "a/c")
    assertEqual(Path.isAbsolute("relativo/x"), false)
    assertEqual(Path.isAbsolute(Path.absolute("x")), true)
    assertEqual(Path.relative(Path.join(Path.temp, "a/b"), Path.temp), "a/b")
    assert(Path.home.length > 0 and Path.temp.length > 0)
})

test("File: copiar, mover, listar y borrar", () => {
    var tmp = Path.join(Path.temp, "hz_file_" + str(Process.pid))
    File.makeDir(Path.join(tmp, "sub"))
    File.write(Path.join(tmp, "a.txt"), "uno")
    File.write(Path.join(tmp, "sub/b.hz"), "dos")
    assertEqual(File.copy(Path.join(tmp, "a.txt"), Path.join(tmp, "c.txt")), true)
    assertEqual(File.move(Path.join(tmp, "c.txt"), Path.join(tmp, "sub/d.txt")), true)
    assertEqual(File.listAll(tmp), ["a.txt", "sub/b.hz", "sub/d.txt"])
    assertEqual(File.listAll(tmp, "hz"), ["sub/b.hz"])
    assertEqual(File.size(Path.join(tmp, "a.txt")), 3)
    assertEqual(File.isFile(Path.join(tmp, "sub")), false)
    assert(abs(File.modified(Path.join(tmp, "a.txt")) - Time.now()) < 120, "fecha de modificación reciente")
    assertEqual(File.deleteDir(tmp), 5)
    assertEqual(File.exists(tmp), false)
    assertThrows(() => File.deleteDir("."))
    assertThrows(() => File.deleteDir(""))
})

test("Time", () => {
    var t = Time.make(2026, 11, 3, 9, 5, 7)
    var d = Time.date(t)
    assertEqual([d.year, d.month, d.day, d.hour, d.minute, d.second], [2026, 11, 3, 9, 5, 7])
    assertEqual(d.dayName, "martes")
    assertEqual(Time.format(t, "%Y-%m-%d %H:%M:%S"), "2026-11-03 09:05:07")
    assert(Time.now() > 1700000000)
    assert(Time.measure(() => System.sleep(0.02)) >= 0.015)
    assert(Time.clock() >= 0)
})

test("System", () => {
    assert(System.cpuCount >= 1)
    assert(System.exe.length > 0)
    assert(["x64", "arm64", "x86", "desconocida"].contains(System.arch))
    System.setEnv("HZ_VARIABLE_PRUEBA", "42")
    assertEqual(System.env("HZ_VARIABLE_PRUEBA"), "42")
    System.setEnv("HZ_VARIABLE_PRUEBA", null)
})
