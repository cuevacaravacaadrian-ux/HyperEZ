// Matrix y sobrecarga de operadores.

test("crear y leer", () => {
    var a = Matrix([[1, 2, 3], [4, 5, 6]])
    assertEqual([a.rows, a.cols, a.size], [2, 3, 6])
    assertEqual(a.get(1, 2), 6)
    assertEqual(a.row(0), [1, 2, 3])
    assertEqual(a.col(1), [2, 5])
    assertEqual(Matrix(2, 2, 7).toList(), [[7, 7], [7, 7]])
    assertEqual(Matrix([1, 2, 3]).toList(), [[1, 2, 3]])
    assertEqual(Matrix.identity(2).toList(), [[1, 0], [0, 1]])
    assertEqual(a.reshape(3, 2).toList(), [[1, 2], [3, 4], [5, 6]])
    assertEqual(a.flatten(), [1, 2, 3, 4, 5, 6])
    assertThrows(() => a.get(5, 0))
    assertThrows(() => Matrix([[1, 2], [3]]))
})

test("operadores +, -, *, / y producto", () => {
    var a = Matrix([[1, 2], [3, 4]])
    var b = Matrix([[5, 6], [7, 8]])
    assertEqual((a + b).toList(), [[6, 8], [10, 12]])
    assertEqual((b - a).toList(), [[4, 4], [4, 4]])
    assertEqual((a * b).toList(), [[5, 12], [21, 32]])
    assertEqual((a / 2).toList(), [[0.5, 1], [1.5, 2]])
    assertEqual((10 * a).toList(), [[10, 20], [30, 40]])
    assertEqual((1 + a).toList(), [[2, 3], [4, 5]])
    assertEqual(a.dot(b).toList(), [[19, 22], [43, 50]])
    assertEqual(a.transpose().toList(), [[1, 3], [2, 4]])
    assertEqual((a + Matrix([[10, 100]])).toList(), [[11, 102], [13, 104]])
    assertEqual((a + Matrix([[10], [100]])).toList(), [[11, 12], [103, 104]])
    assertEqual(a == Matrix([[1, 2], [3, 4]]), true)
    assertThrows(() => a.dot(Matrix(3, 3)))
    assertThrows(() => a + Matrix(3, 3))
})

test("reducciones y activaciones", () => {
    var a = Matrix([[1, 5], [3, 2]])
    assertEqual(a.sum(), 11)
    assertEqual(a.sum(0).toList(), [[4, 7]])
    assertEqual(a.sum(1).toList(), [[6], [5]])
    assertEqual([a.mean(), a.max(), a.min()], [2.75, 5, 1])
    assertEqual(a.argmax(), [1, 0])
    assertEqual(Matrix([[0]]).sigmoid().get(0, 0), 0.5)
    assertEqual(Matrix([[-2, 3]]).relu().toList(), [[0, 3]])
    assertEqual(round(Matrix([[1, 2, 3]]).softmax().sum(), 10), 1)
    assertEqual(Matrix([[4, 9]]).sqrt().toList(), [[2, 3]])
    assertEqual(Matrix([[1, 2]]).map(x => x * 10).toList(), [[10, 20]])
    assertEqual(Matrix([[-5, 5]]).clip(-1, 1).toList(), [[-1, 1]])
})

test("aleatorias con semilla", () => {
    randomSeed(42)
    var a = Matrix.random(3, 3)
    randomSeed(42)
    assertEqual(a.equals(Matrix.random(3, 3)), true)
    assert(a.max() <= 1 and a.min() >= -1)
})

// Sobrecarga de operadores en una clase propia
class Fraccion {
    var n: number
    var d: number
    constructor(n: number, d: number = 1) {
        var g = mcd(abs(n), abs(d))
        this.n = n / g
        this.d = d / g
    }
    function add(o: Fraccion): Fraccion { return Fraccion(n * o.d + o.n * d, d * o.d) }
    function sub(o: Fraccion): Fraccion { return Fraccion(n * o.d - o.n * d, d * o.d) }
    function mul(o: Fraccion): Fraccion { return Fraccion(n * o.n, d * o.d) }
    function div(o: Fraccion): Fraccion { return Fraccion(n * o.d, d * o.n) }
    function compareTo(o: Fraccion): number { return n * o.d - o.n * d }
    function equals(o: Fraccion): bool { return n == o.n and d == o.d }
    function toString(): text { return d == 1 ? str(n) : "${n}/${d}" }
}
function mcd(a: number, b: number): number { return b == 0 ? max(a, 1) : mcd(b, a % b) }

class Pila {
    var datos: list = []
    function get(i: number): any { return datos[i] }
    function set(i: number, v: any): void { datos[i] = v }
    get length(): number { return datos.length }
}

test("operadores en clases propias", () => {
    var a = Fraccion(1, 2)
    var b = Fraccion(1, 3)
    assertEqual(str(a + b), "5/6")
    assertEqual(str(a - b), "1/6")
    assertEqual(str(a * b), "1/6")
    assertEqual(str(a / b), "3/2")
    assertEqual(a > b, true)
    assertEqual(a <= b, false)
    assertEqual(Fraccion(2, 4) == Fraccion(1, 2), true)
    assertEqual(Fraccion(2, 4) != Fraccion(1, 3), true)
    var p = Pila()
    p.datos = [1, 2, 3]
    p[0] = 10
    assertEqual(p[0] + p[2], 13)
    assertEqual(len(p), 3)
})
