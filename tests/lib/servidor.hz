// Http.serve y Process.start: se lanza un servidor de verdad en otro proceso y se le hacen peticiones.

// Un puerto libre: si ya responde alguien en el elegido (otro programa del equipo), se prueba otro
function libre(p: number): bool {
    try {
        Http.get("http://127.0.0.1:${p}/", { timeout: 0.5 })
        return false
    } catch e {
        return true
    }
}
var puerto = 20000 + Process.pid % 20000
var intento = 0
while not libre(puerto) and intento < 20 {
    intento += 1
    puerto = 20000 + (Process.pid * 7 + intento * 911) % 20000
}
var carpeta = Path.join(Path.temp, "hz_servidor_" + str(Process.pid))
File.write(Path.join(carpeta, "public/index.html"), "<h1>Inicio</h1>")
File.write(Path.join(carpeta, "public/estilo.css"), "body { color: red }")
File.write(Path.join(carpeta, "servidor.hz"), """
Http.serve(${puerto}, req => match req.path {
    "/hola" => "Hola, " + req.query.get("nombre", "mundo")
    "/json" => ({ suma: 1 + 2, metodo: req.method })
    "/eco" => ({ status: 201, json: { recibido: req.json, cabecera: req.headers.get("x-prueba") } })
    "/error" => { throw Error("fallo a propósito") }
    else => null
}, { maxRequests: 8, quiet: true, static: "public" })
""")

test("servidor web completo", () => {
    var servidor = Process.start(System.exe, [Path.join(carpeta, "servidor.hz")])
    var base = "http://127.0.0.1:${puerto}"
    var r: any = null
    repeat 100 {                       // esperar a que arranque
        try {
            r = Http.get(base + "/hola?nombre=Ana%20Mar%C3%ADa", { timeout: 2 })
            break
        } catch e {
            System.sleep(0.05)
        }
    }
    assert(r != null, "el servidor arrancó")
    assertEqual([r.status, r.body], [200, "Hola, Ana María"])
    assertEqual(Http.getJson(base + "/json"), { suma: 3, metodo: "GET" })
    var eco = Http.post(base + "/eco", { a: 1 }, { headers: { "X-Prueba": "sí" } })
    assertEqual(eco.status, 201)
    assertEqual(JSON.parse(eco.body), { recibido: { a: 1 }, cabecera: "sí" })
    assertEqual(Http.get(base + "/").body, "<h1>Inicio</h1>")
    var css = Http.get(base + "/estilo.css")
    assertEqual([css.body, css.headers["content-type"].startsWith("text/css")], ["body { color: red }", true])
    assertEqual(Http.get(base + "/no-existe").status, 404)
    assertEqual(Http.get(base + "/../servidor.hz").status, 404)
    assertEqual(Http.get(base + "/error").status, 500)
    assertEqual(servidor.wait(10), 0) // tras 8 peticiones el servidor termina solo
    assertEqual(servidor.running, false)
})

test("Process.start y kill", () => {
    File.write(Path.join(carpeta, "lento.hz"), "System.sleep(30)")
    var p = Process.start(System.exe, [Path.join(carpeta, "lento.hz")])
    assertEqual(p.running, true)
    assertEqual(p.wait(0.2), null)
    assertEqual(p.kill(), true)
    assertEqual(p.running, false)
    File.deleteDir(carpeta)
})
