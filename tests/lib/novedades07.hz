// Novedades de la biblioteca en 0.7: matemáticas, textos, colecciones, números, fechas, hashes, Matrix e Image

test("matemáticas", () => {
    assertEqual(gcd(12, 18), 6)
    assertEqual(lcm(4, 6), 12)
    assertEqual(factorial(5), 120)
    assertEqual(factorial(0), 1)
    assert(isPrime(97) and not isPrime(91) and not isPrime(1))
    assertEqual(primes(20), [2, 3, 5, 7, 11, 13, 17, 19])
    assertEqual(divisors(12), [1, 2, 3, 4, 6, 12])
    assertEqual(cbrt(27), 3)
    assertEqual(trunc(-2.7), -2)
    assertEqual(fract(3.25), 0.25)
    assertEqual(chr(241), "ñ")
    assertEqual(ord("A"), 65)
    var n = noise(1.5, 2.5)
    assert(n >= -1 and n <= 1, "noise entre -1 y 1")
    assertEqual(noise(1.5, 2.5), n) // determinista
    randomSeed(3)
    var g = [1, 2, 3, 4, 5, 6, 7, 8].map(i => randomGaussian(10, 2))
    assert(g.all(x => x > 0 and x < 20))
})

test("textos", () => {
    assertEqual("Canción pingüino Ñandú".removeAccents(), "Cancion pinguino Nandu")
    assertEqual("hola mundo cruel".title(), "Hola Mundo Cruel")
    assertEqual("nombre del jugador".camelCase(), "nombreDelJugador")
    assertEqual("nombre del jugador".pascalCase(), "NombreDelJugador")
    assertEqual("nombreDelJugador".snakeCase(), "nombre_del_jugador")
    assertEqual("Nombre del Jugador".kebabCase(), "nombre-del-jugador")
    assertEqual("¡Hola, Señor Pérez!".slug(), "hola-senor-perez")
    assertEqual("Programar en español".truncate(12), "Programar e…")
    assertEqual("uno dos tres cuatro".wrap(8), "uno dos\ntres\ncuatro")
    assertEqual("gato".distance("pato"), 1)
    assertEqual("kitten".distance("sitting"), 3)
    assert("Hola".similarity("hola") == 1)
    assertEqual("a\nb".indent(2), "  a\n  b")
    assertEqual("    x\n      y".dedent(), "x\n  y")
    assertEqual("<b>negrita</b>".between("<b>", "</b>"), "negrita")
    assertEqual("abc".between("x", "y"), null)
    assert("   ".isBlank() and not " a ".isBlank())
    assertEqual("Añ".codes(), [65, 241])
    assertEqual("uno dos tres".reverseWords(), "tres dos uno")
})

test("listas", () => {
    var votos = ["sí", "no", "sí", "sí"]
    assertEqual(votos.countBy(), {"sí": 3, "no": 1})
    assertEqual([1, 2, 3, 4].countBy(n => n % 2 == 0 ? "par" : "impar"), {impar: 2, par: 2})
    assertEqual([{p: 3}, {p: 4}].sumBy(x => x.p), 7)
    assertEqual(["ana", "Ana", "luis"].uniqueBy(t => t.lower()), ["ana", "luis"])
    assertEqual([1, 2, 3, 4].windowed(2), [[1, 2], [2, 3], [3, 4]])
    assertEqual([1, 2, 3, 4, 5].windowed(2, 2), [[1, 2], [3, 4]])
    assertEqual([1, 2, 3, 4].rotate(1), [2, 3, 4, 1])
    assertEqual([1, 2, 3, 4].rotate(-1), [4, 1, 2, 3])
    assertEqual([1, 2, 3, 2].intersect([2, 3, 5]), [2, 3])
    assertEqual([1, 2, 3].difference([2]), [1, 3])
    assertEqual([1, 2].union([2, 3]), [1, 2, 3])
    assertEqual([1, 2, 5, 1].takeWhile(n => n < 3), [1, 2])
    assertEqual([1, 2, 5, 1].skipWhile(n => n < 3), [5, 1])
    assert([1, 3, 5].none(n => n % 2 == 0))
    randomSeed(1)
    var muestra = [1, 2, 3, 4, 5].sample(3)
    assertEqual(muestra.length, 3)
    assertEqual(muestra.unique().length, 3)
    assertEqual([1, 1, 2].toSet().length, 2)
    assertEqual([1, null, 2, null].compact(), [1, 2])
    assertEqual([2, 3, 4].product(), 24)
    assertEqual([1, 2, 1].lastIndexOf(1), 2)
    assertEqual([1, 3, 5, 7, 9].binarySearch(7), 3)
    assertEqual([1, 3, 5].binarySearch(4), -1)
    assertEqual([1, 2, 3].scan((a, b) => a + b), [1, 3, 6])
    assertEqual([1, 2, 3].scan((a, b) => a + b, 10), [11, 13, 16])
    assertEqual(["a", "b"].enumerate(), [[0, "a"], [1, "b"]])
    assertEqual(["ana", "luis"].toMap(n => n[0], n => n.length), {a: 3, l: 4})
    assertEqual([5, 1, 3].median(), 3)
    assertEqual([4, 1, 3, 2].median(), 2.5)
    var orden = [1, 3, 5]
    assertEqual(orden.insertSorted(4), 2)
    assertEqual(orden, [1, 3, 4, 5])
})

test("mapas", () => {
    var m = {a: 1, b: 2, c: 3}
    assertEqual(m.pick(["a", "c"]), {a: 1, c: 3})
    assertEqual(m.omit(["b"]), {a: 1, c: 3})
    assertEqual({x: "uno"}.invert(), {uno: "x"})
    var cuenta = {}
    cuenta.update("gato", n => n + 1, 0)
    cuenta.update("gato", n => n + 1, 0)
    assertEqual(cuenta.gato, 2)
    assert(m.any(v => v > 2) and m.all(v => v > 0))
    assertEqual(m.count(v => v >= 2), 2)
    assertEqual(m.find(v => v == 2), "b")
    assertEqual(m.mapKeys(k => k.upper()), {A: 1, B: 2, C: 3})
    var puntos = {ana: 5, luis: 9, eva: 7}
    assertEqual(puntos.sortByValue(true).keys(), ["luis", "eva", "ana"])
    assertEqual(puntos.sortByKey().keys(), ["ana", "eva", "luis"])
})

test("conjuntos", () => {
    var a = set(1, 2, 3)
    var b = set(2, 3, 4)
    assertEqual(a.union(b).toList(), [1, 2, 3, 4])
    assertEqual(a.intersect(b).toList(), [2, 3])
    assertEqual(a.difference(b).toList(), [1])
    assertEqual(a.symmetricDifference(b).toList(), [1, 4])
    assert(set(1, 2).isSubset(a) and a.isSuperset([1, 2]) and a.isDisjoint([7, 8]))
    assertEqual(a.map(x => x * 10).toList(), [10, 20, 30])
    assertEqual(a.filter(x => x > 1).toList(), [2, 3])
})

test("números", () => {
    assert((4).isEven() and (7).isOdd())
    assertEqual((15).clamp(0, 10), 10)
    assert((5).between(1, 5))
    assertEqual((2026).toRoman(), "MMXXVI")
    assertEqual((1234567.891).format(2), "1.234.567,89")
    assertEqual((1234567).format(0, ",", "."), "1,234,567")
    assertEqual((-1500).format(), "-1.500")
    assertEqual((2026).digits(), [2, 0, 2, 6])
    var veces = []
    (3).times(i => veces.push(i))
    assertEqual(veces, [0, 1, 2])
    assertEqual((0.256).toPercent(1), "25,6 %")
})

test("fechas", () => {
    var t = Time.make(2024, 1, 31, 12)
    assertEqual(Time.format(Time.addDays(t, 1), "%Y-%m-%d"), "2024-02-01")
    assertEqual(Time.format(Time.addMonths(t, 1), "%Y-%m-%d"), "2024-02-29")
    assertEqual(Time.daysBetween(Time.make(2024, 1, 1), Time.make(2024, 12, 31)), 365)
    assert(Time.isLeapYear(2024) and not Time.isLeapYear(2100))
    assertEqual(Time.daysInMonth(2023, 2), 28)
    assertEqual(Time.monthName(11), "noviembre")
    assertEqual(Time.dayName(3), "miércoles")
    assertEqual(Time.format(Time.parse("2026-11-04 18:30"), "%d/%m/%Y %H:%M"), "04/11/2026 18:30")
    assertEqual(Time.format(Time.parse("4/11/2026"), "%Y-%m-%d"), "2026-11-04")
    assertEqual(Time.parse("31/02/2026"), null)
    assertEqual(Time.duration(3725), "1 h 2 min 5 s")
    assertEqual(Time.duration(1.5), "1,50 s")
    assertEqual(Time.ago(1000, 1300), "hace 5 minutos")
    assertEqual(Time.ago(1000 + 86400 * 2, 1000), "dentro de 2 días")
    assert(Time.today() <= Time.now())
})

test("JSON en archivos", () => {
    var ruta = File.tempFile(".json")
    JSON.save(ruta, {nombre: "Ana", puntos: [1, 2]})
    assertEqual(JSON.load(ruta), {nombre: "Ana", puntos: [1, 2]})
    File.delete(ruta)
})

test("hashes", () => {
    assertEqual(Hash.md5("abc"), "900150983cd24fb0d6963f7d28e17f72")
    assertEqual(Hash.md5(""), "d41d8cd98f00b204e9800998ecf8427e")
    assertEqual(Hash.sha1("abc"), "a9993e364706816aba3e25717850c26c9cd0d89d")
    assertEqual(Hash.hmac("key", "The quick brown fox jumps over the lazy dog"),
                "f7bc83f430538424b13298e6aa6fb143ef4d59a14946175997479dbc2d1a3cd8")
})

test("Matrix: álgebra lineal", () => {
    var a = Matrix([[4, 7], [2, 6]])
    assertEqual(a.det(), 10)
    assert(a.dot(a.inverse()).equals(Matrix.identity(2), 0.000001))
    var x = Matrix([[2, 1], [1, 3]]).solve([3, 5])
    assertEqual(round(x.get(0, 0), 6), 0.8)
    assertEqual(round(x.get(1, 0), 6), 1.4)
    assertEqual(a.trace(), 10)
    assertEqual(Matrix([[3, 4]]).norm(), 5)
    assertEqual(a.diag(), [4, 6])
    assertEqual(Matrix([[1, 2, 3], [4, 5, 6]]).slice(0, 2, 1, 3).toList(), [[2, 3], [5, 6]])
    assertEqual(Matrix.concat([[1, 2]], [[3, 4]]).toList(), [[1, 2], [3, 4]])
    assertEqual(Matrix.concat([[1], [2]], [[3], [4]], 1).toList(), [[1, 3], [2, 4]])
    assertThrows(() => Matrix([[1, 2], [2, 4]]).inverse())
})

test("Image: dibujo y filtros", () => {
    var im = Image(40, 20, "#ffffff")
    im.ellipse(20, 10, 15, 6, "#ff0000")
    assertEqual(im.get(20, 10).toHex(), "#ff0000")
    im.polygon([[0, 0], [10, 0], [0, 10]], "#0000ff")
    assertEqual(im.get(2, 2).toHex(), "#0000ff")
    var rot = im.rotate(90)
    assertEqual([rot.width, rot.height], [20, 40])
    var gr = Image(10, 2).gradient("#000000", "#ffffff", false)
    assertEqual(gr.get(0, 0).toHex(), "#000000")
    assertEqual(gr.get(9, 0).toHex(), "#ffffff")
    var lienzo = Image(10, 10, "#ffffff")
    lienzo.rect(0, 0, 10, 1, "#000000")
    assertEqual(lienzo.floodFill(5, 5, "#00ff00"), 90)
    assertEqual(lienzo.get(5, 5).toHex(), "#00ff00")
    lienzo.blur(1)
    lienzo.brightness(0.5).contrast(1.2).sepia().threshold(100)
    var v = lienzo.get(5, 5).toHex()
    assert(v == "#000000" or v == "#ffffff")
})
