import validate

test("correos y webs", () => {
    assert(validate.email("ana@ejemplo.es"))
    assert(validate.email("  luis.perez+juegos@correo.example.com "))
    assert(not validate.email("ana@ejemplo"))
    assert(not validate.email("ana ejemplo.es"))
    assert(validate.url("https://hyperez.dev/docs?x=1"))
    assert(validate.url("http://localhost:8080"))
    assert(not validate.url("ftp://servidor"))
    assert(not validate.url("https://"))
})

test("teléfonos", () => {
    assert(validate.phone("612 345 678"))
    assert(validate.phone("+34 912-345-678"))
    assert(not validate.phone("512345678")) // en España empiezan por 6, 7, 8 o 9
    assert(validate.phone("+1 (202) 555-0143", "US"))
    assert(not validate.phone("12", "US"))
})

test("DNI, NIE y NIF con la letra de control", () => {
    assert(validate.dni("12345678Z"))
    assert(validate.dni("12345678-z"))
    assert(not validate.dni("12345678A"))
    assertEqual(validate.dniLetter(12345678), "Z")
    assert(validate.nie("X1234567L"))
    assert(not validate.nie("X1234567A"))
    assert(validate.nif("Y1234567X"))
    assert(validate.nif("00000000T"))
})

test("IBAN, tarjetas e ISBN", () => {
    assert(validate.iban("ES91 2100 0418 4502 0005 1332"))
    assert(validate.iban("GB82WEST12345698765432"))
    assert(not validate.iban("ES91 2100 0418 4502 0005 1333")) // un dígito cambiado
    assert(not validate.iban("ES91 2100 0418 4502 0005 13"))   // longitud de España: 24
    assert(validate.card("4539 1488 0343 6467"))
    assert(not validate.card("4539 1488 0343 6468"))
    assert(validate.isbn("978-84-376-0494-7"))
    assert(validate.isbn("0-306-40615-2"))
    assert(not validate.isbn("978-84-376-0494-8"))
})

test("códigos postales, colores, fechas y contraseñas", () => {
    assert(validate.postalCode("28013"))
    assert(not validate.postalCode("53000"))
    assert(validate.hexColor("#ff8800"))
    assert(validate.hexColor("#F80"))
    assert(not validate.hexColor("ff8800"))
    assert(validate.date("2024-02-29"))     // bisiesto
    assert(not validate.date("2023-02-29"))
    assert(not validate.date("2024-13-01"))
    assert(validate.strongPassword("Secreto123"))
    assert(not validate.strongPassword("secreto123"))
})

test("check: un formulario con reglas", () => {
    var reglas = {
        nombre: { required: true, min: 2 },
        edad: { type: "number", min: 18, max: 120 },
        correo: "email",
        rol: { oneOf: ["admin", "jugador"] },
        alias: { pattern: r"[a-z0-9_]{3,12}", message: "solo minúsculas, números y _" },
        codigo: { custom: c => c.startsWith("HZ") or "debe empezar por HZ" },
    }
    var errores = validate.check({ nombre: "A", edad: "15", correo: "x@", rol: "rey", alias: "Ana!", codigo: "AB1" }, reglas)
    assertEqual(errores.nombre, "debe tener al menos 2 caracteres")
    assertEqual(errores.edad, "debe ser como mínimo 18") // "15" del formulario cuenta como número
    assertEqual(errores.correo, "no es un email válido")
    assertEqual(errores.rol, "debe ser uno de: admin, jugador")
    assertEqual(errores.alias, "solo minúsculas, números y _")
    assertEqual(errores.codigo, "debe empezar por HZ")
    var bien = { nombre: "Ana", edad: 30, correo: "ana@ejemplo.es", rol: "admin", alias: "ana_99", codigo: "HZ7" }
    assertEqual(validate.check(bien, reglas), {})
    assert(validate.valid(bien, reglas))
})

test("check: obligatorios, vacíos y tipos", () => {
    assertEqual(validate.check({}, { correo: "email" }), { correo: "es obligatorio" })
    assertEqual(validate.check({ nota: "" }, { nota: { min: 3 } }), {}) // vacío y no obligatorio: vale
    assertEqual(validate.check({ n: 2.5 }, { n: { type: "integer" } }), { n: "debe ser un número entero" })
    assertEqual(validate.check({ l: [1] }, { l: { type: "list", min: 2 } }), { l: "debe tener al menos 2 elementos" })
    assertEqual(validate.check({ x: 5 }, { x: { type: "text" } }), { x: "debe ser de tipo text, no number" })
})

test("ensure lanza un error con todos los fallos", () => {
    var e = assertThrows(() => validate.ensure({ nombre: "" }, { nombre: { required: true }, correo: "email" }))
    assertEqual(e.message, "nombre: es obligatorio; correo: es obligatorio")
    assertEqual(validate.ensure({ correo: "a@b.es" }, { correo: "email" }).correo, "a@b.es")
})
