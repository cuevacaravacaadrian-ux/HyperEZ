// Control de flujo, funciones y clausuras.

test("bucles", () => {
    var total = 0
    repeat 3 { total += 1 }
    for i in 0..5 { total += i }
    for i in 1..=3 { total += i }
    foreach x in [10, 20] { total += x }
    for i, x in ["a", "b"] { total += i }
    var w = 0
    while true {
        w++
        if w == 2 { continue }
        if w >= 5 { break }
    }
    assertEqual(total, 3 + 10 + 6 + 30 + 1)
    assertEqual(w, 5)
    var letras = ""
    foreach c in "hola" { letras = c + letras }
    assertEqual(letras, "aloh")
})

test("condicionales y operadores", () => {
    var x = 7
    var r = x > 5 ? "grande" : "pequeño"
    assertEqual(r, "grande")
    assertEqual(not (x > 5 and x < 6), true)
    assertEqual(x == 7 or false, true)
    var n = null
    n ??= 3
    assertEqual(n, 3)
    var m = { a: { b: 1 } }
    assertEqual(m?.a?.b, 1)
    assertEqual(m?.z?.b, null)
    var i = 1
    i += 2
    i *= 3
    i -= 1
    i /= 2
    assertEqual(i, 4)
    assertEqual(3 not in [1, 2], true)
})

test("match", () => {
    function describir(x: any): text {
        return match x {
            0 => "cero"
            1, 2, 3 => "pequeño"
            4..10 => "medio"
            "hola" => "saludo"
            else => "otro"
        }
    }
    assertEqual([0, 2, 7, "hola", 99].map(describir), ["cero", "pequeño", "medio", "saludo", "otro"])
    var n = -5
    var signo = match n {
        0 => "cero"
        else if n < 0 => "negativo"
        else => "positivo"
    }
    assertEqual(signo, "negativo")
    // el último valor de un bloque es el resultado del caso
    var log = []
    var puntos = match "oro" {
        "oro" => { log.add("brilla"); 100 }
        "plata" => { var base = 25; base * 2 }
        else => 0
    }
    assertEqual([puntos, log], [100, ["brilla"]])
    var plata = match "plata" { "plata" => { var base = 25; base * 2 } else => 0 }
    assertEqual(plata, 50)
})

test("funciones: valores por defecto, nombre y resto", () => {
    function danio(base: number, mult: number = 2, ...extra: number): number {
        return base * mult + extra.sum()
    }
    assertEqual(danio(10), 20)
    assertEqual(danio(10, 3), 30)
    assertEqual(danio(base: 5, mult: 4), 20)
    assertEqual(danio(1, 1, 1, 2, 3), 7)
    var args = [2, 5]
    assertEqual(danio(...args), 10)
})

test("clausuras", () => {
    function contador() {
        var c = 0
        return () => {
            c += 1
            return c
        }
    }
    var a = contador()
    var b = contador()
    a(); a()
    assertEqual(a(), 3)
    assertEqual(b(), 1)
    var fs = []
    for i in 0..3 { fs.add(() => i * 10) }
    assertEqual(fs.map(f => f()), [0, 10, 20])
})

test("recursión", () => {
    function fib(n: number): number { return n < 2 ? n : fib(n - 1) + fib(n - 2) }
    assertEqual(fib(20), 6765)
    function hanoi(n: number, a: text, b: text, c: text, movs: list) {
        if n == 0 { return }
        hanoi(n - 1, a, c, b, movs)
        movs.add(a + c)
        hanoi(n - 1, b, a, c, movs)
    }
    var movs = []
    hanoi(5, "A", "B", "C", movs)
    assertEqual(movs.length, 31)
})

test("errores en tiempo de ejecución capturables", () => {
    assertEqual(assertThrows(() => [1, 2][5]).message.contains("fuera"), true)
    assertThrows(() => 1 / 0)
    var nada: any = null
    assertThrows(() => nada.x)
    var e = assertThrows(() => {
        function infinita(n: number): number { return infinita(n + 1) }
        infinita(0)
    })
    assert(e.message.contains("recursión") or e.message.contains("pila"), e.message)
})
