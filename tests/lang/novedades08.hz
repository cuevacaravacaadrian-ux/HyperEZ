// Sintaxis nueva en 0.8: tubería |>, comprensiones, propagación en mapas, **= y rangos abiertos

function doble(x: number): number { return x * 2 }
function sumar(a: number, b: number): number { return a + b }

test("tubería |>", () => {
    assertEqual(5 |> doble, 10)
    assertEqual(5 |> doble |> sumar(1), 11) // el valor entra como primer argumento
    assertEqual([3, 1, 2] |> len, 3)
    var r = [1, 2, 3, 4, 5, 6]
        |> (l => l.filter(n => n % 2 == 0))
        |> (l => l.map(n => n * 10))
    assertEqual(r, [20, 40, 60])
    assertEqual("hola" |> (t => t.upper()), "HOLA")
    assertEqual(2 + 3 |> doble, 10) // la tubería va después de la aritmética
})

test("comprensiones de lista", () => {
    assertEqual([x * x for x in 1..=5], [1, 4, 9, 16, 25])
    assertEqual([x for x in [5, 1, 8, 3] if x > 2], [5, 8, 3])
    assertEqual([i * 10 + x for i, x in [1, 2, 3]], [1, 12, 23])
    assertEqual([x for x in 0..10 step 4], [0, 4, 8])
    assertEqual([c.upper() for c in "abc".chars()], ["A", "B", "C"])
    assertEqual([[y * x for y in 1..=3] for x in 1..=2], [[1, 2, 3], [2, 4, 6]])
    var limite = 3
    assertEqual([x for x in 1..=10 if x <= limite], [1, 2, 3]) // ve las variables de fuera
    assertEqual([x for x in []], [])
})

test("comprensiones de mapa", () => {
    assertEqual({[n]: n * n for n in 1..=3}, {1: 1, 2: 4, 3: 9})
    assertEqual({n: "#" * n for n in 1..=2}, {1: "#", 2: "##"})
    assertEqual({k: v * 10 for k, v in {a: 1, b: 2}}, {a: 10, b: 20})
    assertEqual({[p.nombre]: p.edad for p in [{nombre: "Ana", edad: 30}] if p.edad > 18}, {Ana: 30})
})

test("propagación ... en mapas", () => {
    var base = {a: 1, b: 2}
    assertEqual({...base, b: 20, c: 3}, {a: 1, b: 20, c: 3})
    assertEqual({x: 0, ...base}, {x: 0, a: 1, b: 2})
    assertEqual({...base, ...{c: 3}}, {a: 1, b: 2, c: 3})
    var copia = {...base}
    copia.a = 99
    assertEqual(base.a, 1) // el original no cambia
})

test("**=", () => {
    var p = 2
    p **= 10
    assertEqual(p, 1024)
})

test("rangos abiertos en índices", () => {
    var l = [1, 2, 3, 4, 5, 6]
    assertEqual(l[2..], [3, 4, 5, 6])
    assertEqual(l[..2], [1, 2])
    assertEqual(l[..=2], [1, 2, 3])
    assertEqual(l[-2..], [5, 6])
    assertEqual(l[..], l)
    assertEqual(l[1..3], [2, 3])
    assertEqual(l[10..], [])
    assertEqual("Programar"[3..], "gramar")
    assertEqual("Programar"[..3], "Pro")
    assertEqual("Programar"[-3..], "mar")
    assertEqual("año"[1..], "ño")
})
