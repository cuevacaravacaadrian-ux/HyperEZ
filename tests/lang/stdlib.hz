// Biblioteca estándar: números, textos, listas, mapas, conjuntos, rangos, JSON, archivos y sistema.

test("números y matemáticas", () => {
    assertEqual(abs(-3), 3)
    assertEqual(floor(2.7), 2)
    assertEqual(ceil(2.1), 3)
    assertEqual(round(2.567, 2), 2.57)
    assertEqual(clamp(15, 0, 10), 10)
    assertEqual(lerp(0, 10, 0.25), 2.5)
    assertEqual(min(3, 1, 2), 1)
    assertEqual(max([4, 9, 2]), 9)
    assertEqual(sign(-5), -1)
    assertEqual(pow(2, 10), 1024)
    assertEqual(2 ** 3, 8)
    assertEqual(7 % 3, 1)
    assertEqual(-7 % 3, 2)
    assertEqual(7.5 % 2, 1.5)
    assertEqual(degrees(PI), 180)
    assertEqual(toInt(3.99), 3)
    assertEqual((3.14159).toFixed(2), "3.14")
    assertEqual((4).isInteger(), true)
    assertEqual(toNumber("42"), 42)
    assertEqual(toNumber("hola"), null)
    assertEqual(toNumber("x", 0), 0)
    assertEqual(0xFF, 255)
    assertEqual(0b1010, 10)
    assertEqual(1_000_000, 1000000)
    assertEqual(5 & 3, 1)
    assertEqual(5 | 3, 7)
    assertEqual(1 << 4, 16)
})

test("utilidades para juegos", () => {
    assertEqual(remap(5, 0, 10, 0, 100), 50)
    assertEqual(wrap(11, 0, 10), 1)
    assertEqual(wrap(-1, 0, 10), 9)
    assertEqual(approach(8, 10, 5), 10)
    assertEqual(approach(8, 0, 5), 3)
    assertEqual(smoothstep(0, 1, 0.5), 0.5)
    assertEqual(distance(0, 0, 3, 4), 5)
    randomSeed(1)
    var a = [random(), randomInt(1, 6), randomChoice(["a", "b"])]
    randomSeed(1)
    var b = [random(), randomInt(1, 6), randomChoice(["a", "b"])]
    assertEqual(a, b, "randomSeed hace repetibles los resultados")
    var r = randomInt(1, 6)
    assert(r >= 1 and r <= 6)
    assertEqual(chance(0), false)
    assertEqual(chance(1), true)
})

test("textos", () => {
    var t = "  Hola Mundo  "
    assertEqual(t.trim(), "Hola Mundo")
    assertEqual(t.trim().lower(), "hola mundo")
    assertEqual("ñandú".upper(), "ÑANDÚ")
    assertEqual(len("ñandú"), 5)
    assertEqual("abc"[1], "b")
    assertEqual("abc"[-1], "c")
    assertEqual("x" * 3, "xxx")
    assertEqual("a,b,c".split(","), ["a", "b", "c"])
    assertEqual("hola".contains("ol"), true)
    assertEqual("ell" in "hola ella", true)
    assertEqual("hola".startsWith("ho"), true)
    assertEqual("hola".replace("o", "0"), "h0la")
    assertEqual("hola mundo".indexOf("mundo"), 5)
    assertEqual("abcdef".substring(1, 3), "bc")
    assertEqual("7".padStart(3, "0"), "007")
    assertEqual("ab".repeat(2), "abab")
    assertEqual("abc".chars(), ["a", "b", "c"])
    assertEqual("abc".reverse(), "cba")
    assertEqual("una\ndos".lines(), ["una", "dos"])
    assertEqual("".isEmpty(), true)
    assertEqual("banana".count("a"), 3)
    assertEqual("ñu".capitalize(), "Ñu")
    assertEqual(" uno  dos ".words(), ["uno", "dos"])
    assertEqual("12.5".isNumeric(), true)
    assertEqual("ab".center(6, "*"), "**ab**")
    assertEqual("{} tiene {} puntos, {0}".format("Ana", 10), "Ana tiene 10 puntos, Ana")
    var nombre = "Ana"
    assertEqual("Hola, ${nombre}! ${1 + 2}", "Hola, Ana! 3")
    assertEqual("""línea 1
línea 2""".lines().length, 2)
    assertEqual('simples con "dobles"', "simples con \"dobles\"")
})

test("listas", () => {
    var l = [5, 3, 8, 1]
    assertEqual(l.length, 4)
    assertEqual(l[-1], 1)
    assertEqual(l[1..3], [3, 8])
    assertEqual(l.copy().sort(), [1, 3, 5, 8])
    assertEqual(l.map(x => x * 2), [10, 6, 16, 2])
    assertEqual(l.filter(x => x > 2), [5, 3, 8])
    assertEqual(l.reduce((a, b) => a + b, 0), 17)
    assertEqual(l.sum(), 17)
    assertEqual(l.find(x => x > 5), 8)
    assertEqual(l.findIndex(x => x == 8), 2)
    assertEqual(l.any(x => x > 7), true)
    assertEqual(l.all(x => x > 0), true)
    assertEqual(l.count(x => x % 2 == 1), 3)
    assertEqual(l.indexOf(8), 2)
    assertEqual(9 in l, false)
    assertEqual([3, 1, 2].sortBy(x => -x), [3, 2, 1])
    assertEqual([1, 1, 2, 3, 3].unique(), [1, 2, 3])
    assertEqual([1, 2, 3].reversed(), [3, 2, 1])
    assertEqual([1, 2, 3].join("-"), "1-2-3")
    assertEqual([1, 2] + [3], [1, 2, 3])
    var m = [1, 2, 3]
    m.add(4)
    m.insert(0, 0)
    assertEqual(m.pop(), 4)
    assertEqual(m.shift(), 0)
    m.removeAt(0)
    assertEqual(m, [2, 3])
    assertEqual([1, 2, 3].zip(["a", "b"]), [[1, "a"], [2, "b"]])
    assertEqual([[1, 2], [3, [4]]].flat(), [1, 2, 3, [4]])
    assertEqual([1, 2].flatMap(x => [x, x * 10]), [1, 10, 2, 20])
    assertEqual([1, 2, 3, 4, 5].chunk(2), [[1, 2], [3, 4], [5]])
    assertEqual([1, 2, 3].take(2), [1, 2])
    assertEqual([1, 2, 3].skip(2), [3])
    assertEqual(["ana", "alba", "bea"].groupBy(n => n[0]), { a: ["ana", "alba"], b: ["bea"] })
    assertEqual(["aa", "b", "ccc"].maxBy(s => len(s)), "ccc")
    assertEqual(["aa", "b", "ccc"].minBy(s => len(s)), "b")
    assertEqual([1, 2, 3, 4].average(), 2.5)
    assertEqual([1, 2, 3, 4].partition(x => x % 2 == 0), [[2, 4], [1, 3]])
    assertEqual([1, 2, 3].swap(0, 2), [3, 2, 1])
    assertEqual([0, 0].fill(7), [7, 7])
    var a = [1, 2]
    assertEqual([...a, 3, ...a], [1, 2, 3, 1, 2])
})

test("mapas y conjuntos", () => {
    var m = { nombre: "zed", hp: 10 }
    m.mp = 5
    m["oro"] = 3
    assertEqual(m.keys(), ["nombre", "hp", "mp", "oro"])
    assertEqual(m.get("nada", "def"), "def")
    assertEqual(m.has("hp"), true)
    assertEqual(m?.nada?.x ?? "por defecto", "por defecto")
    m.remove("oro")
    assertEqual(m.length, 3)
    assertEqual({ a: 1, b: 2 }.filter((k, v) => v > 1), { b: 2 })
    assertEqual({ a: 1, b: 2 }.mapValues(v => v * 10), { a: 10, b: 20 })
    assertEqual({ a: 1, b: 2 }.keyOf(2), "b")
    var total = 0
    foreach k, v in { a: 1, b: 2 } { total += v }
    assertEqual(total, 3)
    var s = set(1, 2, 2, 3)
    assertEqual(s.length, 3)
    assertEqual(2 in s, true)
    s.add(9)
    assertEqual(s.toList(), [1, 2, 3, 9])
})

test("rangos", () => {
    assertEqual(range(4).toList(), [0, 1, 2, 3])
    assertEqual(range(2, 5).toList(), [2, 3, 4])
    assertEqual(range(0, 10, 3).toList(), [0, 3, 6, 9])
    assertEqual((1..=3).toList(), [1, 2, 3])
    assertEqual((0..5).length, 5)
    assertEqual((0..10).contains(4), true)
    var pasos = []
    for i in 10..0 step -3 { pasos.add(i) }
    assertEqual(pasos, [10, 7, 4, 1])
})

test("JSON", () => {
    var datos = { nombre: "Ana", nivel: 3, objetos: ["espada", "poción"], activo: true, nada: null }
    var texto = JSON.stringify(datos)
    assertEqual(JSON.parse(texto), datos)
    assertEqual(JSON.parse("[1, 2.5, \"ñ\", {\"a\": [true]}]"), [1, 2.5, "ñ", { a: [true] }])
    assert(JSON.stringify({ a: 1 }, 2).contains("\n"), "con sangría ocupa varias líneas")
})

test("archivos", () => {
    var dir = "_tmp_stdlib"
    File.write(dir + "/partida.json", JSON.stringify({ puntos: 120 }))
    assertEqual(File.exists(dir + "/partida.json"), true)
    assertEqual(JSON.parse(File.read(dir + "/partida.json")).puntos, 120)
    File.append(dir + "/log.txt", "uno\n")
    File.append(dir + "/log.txt", "dos\n")
    assertEqual(File.readLines(dir + "/log.txt"), ["uno", "dos"])
    assertEqual(File.list(dir), ["log.txt", "partida.json"])
    assertEqual(File.isDir(dir), true)
    File.delete(dir + "/partida.json")
    File.delete(dir + "/log.txt")
    File.delete(dir)
    assertEqual(File.exists(dir), false)
    assertThrows(() => File.read("no_existe.txt"))
})

test("sistema", () => {
    assertEqual(typeof(System.args), "list")
    assert(System.version.length > 0)
    assert(["windows", "linux", "macos"].contains(System.platform))
    var d = System.date()
    assert(d.year >= 2024 and d.month >= 1 and d.month <= 12)
    assertEqual(typeof(time()), "number")
    assertEqual(typeof(Console.interactive), "bool")
})

test("tipos y conversión", () => {
    assertEqual(typeof(1), "number")
    assertEqual(typeof("a"), "text")
    assertEqual(typeof([]), "list")
    assertEqual(typeof({}), "map")
    assertEqual(typeof(null), "null")
    assertEqual(typeof(x => x), "function")
    assertEqual(str(3.5), "3.5")
    assertEqual(str([1, "a"]), "[1, \"a\"]")
    assertEqual(isNaN(0 / 1), false)
})

test("vectores y colores", () => {
    var v = Vec2(3, 4)
    assertEqual(v.length(), 5)
    assertEqual(v + Vec2(1, 1), Vec2(4, 5))
    assertEqual(v * 2, Vec2(6, 8))
    assertEqual(v.normalized().length(), 1)
    assertEqual(Vec2(1, 0).dot(Vec2(0, 1)), 0)
    assertEqual(Vec3.up, Vec3(0, 1, 0))
    assertEqual(Color.hex("#ff8800"), Color(255, 136, 0))
    assertEqual(Color("red").toHex(), "#e62937")
})
