// Programa con mala sangría: hyper fmt lo deja como desordenado.ordenado.hz
class Punto {
var x = 0
      var y = 0
  function mover(dx: number, dy: number) {
x += dx
        y += dy
  }
}

function resumen(lista: list): text {
  if lista.isEmpty() {
            return "vacía"
  } else {
  var total = lista
  .map(n => n * 2)
          .sum()
  return "total ${total}"
  }
}



var p = Punto()
p.mover(1, 2)
var datos = {
nombre: "Ana",
   puntos: [1, 2,
   3],
}
var texto = """
  esto no se toca
      ni esto
"""
match p.x {
1 => print("uno")
  else => print("otro")
}
print(resumen([1, 2, 3]), p.y, datos.nombre, texto.trim())


