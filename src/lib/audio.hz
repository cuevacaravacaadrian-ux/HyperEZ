// audio — crear sonidos y música y guardarlos como archivos WAV.
//
//   import audio
//   var s = audio.Sound()
//   s.melody("C4 E4 G4 C5", 0.25)            // notas en notación inglesa (C = do, D = re...)
//   s.tone(440, 0.5, 0.3, "square")         // frecuencia, segundos, volumen y forma de onda
//   s.save("melodia.wav")
//
// Formas de onda: "sine" (suave), "square" (de videojuego antiguo), "triangle", "saw" y "noise".

const SAMPLE_RATE = 22050
const SEMITONOS = { C: -9, D: -7, E: -5, F: -4, G: -2, A: 0, B: 2 }

/// Frecuencia en hercios de una nota: "A4" = 440, "C#5", "Bb3". Un número se devuelve tal cual.
function frequency(nota: any): number {
    if typeof(nota) == "number" { return nota }
    var t = str(nota).trim()
    var base = SEMITONOS.get(t[0].upper())
    if base == null { throw Error("nota desconocida '${t}' (usa C, D, E, F, G, A o B, por ejemplo \"C4\" o \"F#3\")") }
    var i = 1
    if t.length > i and t[i] == "#" { base += 1; i += 1 }
    else if t.length > i and t[i] == "b" { base -= 1; i += 1 }
    var octava = t.length > i ? toNumber(t.substring(i)) : 4
    if octava == null { throw Error("octava no válida en la nota '${t}'") }
    return 440 * 2 ** ((base + (octava - 4) * 12) / 12)
}

/// Valor de una onda en la fase f (0..1).
function wave(forma: text, f: number): number {
    return match forma {
        "square" => f < 0.5 ? 1 : -1
        "triangle" => f < 0.5 ? 4 * f - 1 : 3 - 4 * f
        "saw" => 2 * f - 1
        "noise" => random(-1, 1)
        else => sin(2 * PI * f)
    }
}

/// Sonido en memoria: una lista de muestras entre -1 y 1.
class Sound {
    var samples: list = []
    var rate: number

    constructor(frecuenciaMuestreo: number = SAMPLE_RATE) { rate = frecuenciaMuestreo }

    get duration(): number { return samples.length / rate }

    /// Añade un tono. Lleva una entrada y salida suaves para que no se oigan chasquidos.
    function tone(frecuencia: number, segundos: number, volumen: number = 0.4, forma: text = "sine"): Sound {
        var n = round(segundos * rate)
        var suave = min(n / 4, rate * 0.01)
        var fase = 0
        var paso = frecuencia / rate
        for i in 0..n {
            var env = min(1, i / max(1, suave), (n - i) / max(1, suave))
            samples.add(wave(forma, fase) * volumen * env)
            fase = (fase + paso) % 1
        }
        return this
    }

    /// Añade una nota ("A4", "C#5"...). "-" o "R" es un silencio.
    function note(nota: text, segundos: number, volumen: number = 0.4, forma: text = "sine"): Sound {
        if nota == "-" or nota.upper() == "R" { return silence(segundos) }
        return tone(frequency(nota), segundos, volumen, forma)
    }

    /// Añade varias notas separadas por espacios, cada una de la misma duración.
    function melody(notas: text, segundos: number = 0.25, volumen: number = 0.4, forma: text = "sine"): Sound {
        foreach n in notas.split(" ").filter(x => x != "") { note(n, segundos, volumen, forma) }
        return this
    }

    function silence(segundos: number): Sound {
        repeat round(segundos * rate) { samples.add(0) }
        return this
    }

    /// Suma otro sonido encima, empezando en el segundo 'desde' (para acordes o efectos).
    function mix(otro: Sound, desde: number = 0): Sound {
        var inicio = round(desde * rate)
        while samples.length < inicio + otro.samples.length { samples.add(0) }
        foreach i, v in otro.samples { samples[inicio + i] = clamp(samples[inicio + i] + v, -1, 1) }
        return this
    }

    /// El sonido como archivo WAV (PCM de 16 bits, mono).
    function toBytes(): Bytes {
        var datos = samples.length * 2
        var b = Bytes("RIFF").pushU32(36 + datos).push("WAVEfmt ").pushU32(16).pushU16(1).pushU16(1)
        b.pushU32(rate).pushU32(rate * 2).pushU16(2).pushU16(16).push("data").pushU32(datos)
        foreach v in samples { b.pushU16(round(clamp(v, -1, 1) * 32767) & 0xFFFF) }
        return b
    }

    function save(ruta: text) { File.writeBytes(ruta, toBytes()) }
}
