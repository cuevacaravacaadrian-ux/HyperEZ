// template — plantillas de texto con {{variables}}, condiciones y bucles (correos, informes, páginas web).
//
//   import template
//   var t = "Hola, {{nombre}}. Tienes {{mensajes.length}} mensajes:\n{{#each mensajes}}- {{asunto}}\n{{/each}}"
//   print(template.render(t, { nombre: "Ana", mensajes: [{ asunto: "Reunión" }, { asunto: "Fotos" }] }))
//
// Sintaxis:
//   {{nombre}}  {{jugador.puntos}}  {{lista.length}}   valor (en HTML se escapa: usa {{{x}}} para no escapar)
//   {{#if x}} ... {{else}} ... {{/if}}                  condición (x vacío, 0, false o null es falso)
//   {{#unless x}} ... {{/unless}}                       lo contrario de if
//   {{#each lista}} ... {{/each}}                       repite; dentro: {{this}}, {{@index}}, {{@first}}, {{@last}} y los campos
//   {{! comentario }}                                   no aparece en el resultado

/// Valor de una ruta "a.b.c" en el contexto (o null).
function lookup(contexto: list, ruta: text): any {
    var r = ruta.trim()
    if r == "this" or r == "." { return contexto.last().this }
    var partes = r.split(".")
    // se busca desde el contexto más interno hacia fuera
    for i in range(contexto.length - 1, -1, -1) {
        var c = contexto[i]
        var v: any = null
        var encontrado = false
        if c.has(partes[0]) {
            v = c[partes[0]]
            encontrado = true
        } else if typeof(c.this) == "map" and c.this.has(partes[0]) {
            v = c.this[partes[0]]
            encontrado = true
        }
        if encontrado {
            foreach p in partes.skip(1) {
                if v == null { return null }
                if p == "length" and (typeof(v) == "list" or typeof(v) == "text" or typeof(v) == "map") { v = len(v) }
                else if typeof(v) == "map" { v = v.get(p) }
                else { return null }
            }
            return v
        }
    }
    return null
}

function truthy(v: any): bool {
    if v == null or v == false or v == 0 or v == "" { return false }
    if typeof(v) == "list" or typeof(v) == "map" { return len(v) > 0 }
    return true
}

function escapeHtml(t: text): text {
    return t.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;").replace("\"", "&quot;").replace("'", "&#39;")
}

/// Busca el cierre {{/nombre}} que corresponde (respetando bloques anidados) y el {{else}} de este nivel.
function findClose(t: text, desde: number, nombre: text): map {
    var nivel = 1
    var i = desde
    var elsePos = -1
    while i < t.length {
        var a = t.indexOf("{{", i)
        if a < 0 { break }
        var b = t.indexOf("}}", a)
        if b < 0 { break }
        var tag = t.substring(a + 2, b).trim()
        if tag.startsWith("#") { nivel += 1 }
        else if tag.startsWith("/") {
            nivel -= 1
            if nivel == 0 { return { start: a, end: b + 2, elsePos: elsePos } }
        } else if tag == "else" and nivel == 1 { elsePos = a }
        i = b + 2
    }
    throw Error("template: falta {{/${nombre}}}")
}

function renderIn(t: text, contexto: list, html: bool): text {
    var out = []
    var i = 0
    while i < t.length {
        var a = t.indexOf("{{", i)
        if a < 0 {
            out.add(t.substring(i))
            break
        }
        out.add(t.substring(i, a))
        var triple = t.substring(a, a + 3) == "{{{"
        var b = t.indexOf(triple ? "}}}" : "}}", a)
        if b < 0 { throw Error("template: falta '}}' para cerrar la etiqueta que empieza en la posición ${a}") }
        var tag = t.substring(a + (triple ? 3 : 2), b).trim()
        var despues = b + (triple ? 3 : 2)
        if tag.startsWith("!") {
            i = despues
        } else if tag.startsWith("#") {
            var partes = tag.substring(1).trim().split(" ")
            var tipo = partes[0]
            var expr = partes.skip(1).join(" ")
            var cierre = findClose(t, despues, tipo)
            var cuerpo = t.substring(despues, cierre.elsePos >= 0 ? cierre.elsePos : cierre.start)
            var otro = cierre.elsePos >= 0 ? t.substring(t.indexOf("}}", cierre.elsePos) + 2, cierre.start) : ""
            var v = lookup(contexto, expr)
            if tipo == "if" {
                out.add(renderIn(truthy(v) ? cuerpo : otro, contexto, html))
            } else if tipo == "unless" {
                out.add(renderIn(truthy(v) ? otro : cuerpo, contexto, html))
            } else if tipo == "each" {
                var lista = v == null ? [] : (typeof(v) == "map" ? v.entries().map(e => ({ key: e[0], value: e[1] })) : v)
                if len(lista) == 0 { out.add(renderIn(otro, contexto, html)) }
                var n = len(lista)
                var k = 0
                foreach item in lista {
                    var nuevo = contexto + [{ this: item, "@index": k, "@first": k == 0, "@last": k == n - 1 }]
                    out.add(renderIn(cuerpo, nuevo, html))
                    k += 1
                }
            } else {
                throw Error("template: bloque desconocido '#${tipo}' (usa if, unless o each)")
            }
            i = cierre.end
        } else {
            var v = lookup(contexto, tag)
            var s = v == null ? "" : str(v)
            out.add(html and not triple ? escapeHtml(s) : s)
            i = despues
        }
    }
    return out.join("")
}

/// Una línea que solo contiene una etiqueta de bloque ({{#each x}}, {{/if}}, {{else}}, {{! ... }}) no deja
/// su salto de línea en el resultado (como en Mustache): así las listas y los párrafos salen seguidos.
function standalone(t: text): text {
    var lineas = t.split("\n")
    var out = []
    for i in 0..lineas.length {
        var tr = lineas[i].trim()
        var bloque = tr.startsWith("{{") and tr.endsWith("}}") and tr.indexOf("}}") == tr.length - 2 and
                     (tr.startsWith("{{#") or tr.startsWith("{{/") or tr.startsWith("{{!") or tr == "{{else}}")
        if bloque { out.add(tr) }
        else { out.add(i < lineas.length - 1 ? lineas[i] + "\n" : lineas[i]) }
    }
    return out.join("")
}

/// Rellena la plantilla con los datos.
function render(plantilla: text, datos: map = {}): text { return renderIn(standalone(plantilla), [datos], false) }

/// Igual que render, pero escapa los valores para HTML (< > & " ') salvo los {{{triples}}}.
function renderHtml(plantilla: text, datos: map = {}): text { return renderIn(standalone(plantilla), [datos], true) }

/// Lee la plantilla de un archivo y la rellena.
function renderFile(ruta: text, datos: map = {}): text {
    var t = File.read(ruta)
    return ruta.lower().endsWith(".html") ? renderHtml(t, datos) : render(t, datos)
}
